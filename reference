  isolation: isolate;
  color: var(--market-text-secondary);
  background:
    radial-gradient(circle at 100% 0%, rgba(103, 193, 245, 0.045), transparent 28%),
    linear-gradient(135deg, rgba(29, 47, 62, 0.94), rgba(15, 25, 34, 0.98));
  border: 1px solid rgba(103, 193, 245, 0.11);
  border-radius: 13px 4px 13px 7px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.024), 0 9px 24px rgba(0, 0, 0, 0.19);
