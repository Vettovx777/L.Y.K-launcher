  border-color: var(--market-accent, var(--steam-accent)) !important;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.055),
    0 0 0 2px rgba(26, 159, 255, 0.5),
    0 8px 18px rgba(0, 0, 0, 0.18) !important;
}

/* Controles retangulares nativos adotam a mesma gota em todos os estados. */
.game-options-modal__sidebar-button,
.game-options-modal__sidebar-button:hover,
.game-options-modal__sidebar-button:focus,
.game-options-modal__sidebar-button:focus-visible,
.game-options-modal__sidebar-button:active,
.disc-field__trigger,
.disc-field__trigger:hover,
.disc-field__trigger:focus-visible,
.disc-field__option,
.disc-field__option:hover,
.disc-field__option:focus-visible,
.drive-card,
.drive-card:hover,
.drive-card:focus-visible {
