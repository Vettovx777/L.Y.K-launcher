/* ========================================================================== */
/* STEAMSHIT 6.6 — FIX DE SCROLL DUPLO + BUSCA/BTN SEM RECORTE                */
/* ========================================================================== */

/* Impede a barra duplicada do shell nas páginas que já têm rolagem interna. */
.container__content {
  overflow: hidden !important;
}

/*
   O perfil é a exceção: no DOM do Hydra ele não possui um scroller interno.
   #scrollableDiv (.container__content) continua sendo o alvo usado também pelo
   carregamento incremental da biblioteca, então a rolagem volta somente aqui.
*/
.container__content:has(> .profile__wrapper) {
  overflow-x: hidden !important;
  overflow-y: auto !important;
  overscroll-behavior-y: contain;
}

/* A busca não sobe nem escala ao hover/foco, evitando cortar a borda superior. */
.header {
  overflow: visible !important;
}

.header__search,
.header__search:hover,
.header__search:focus,
.header__search:focus-within {
  border-radius: 12px !important;
  overflow: hidden;
  transform: none !important;
}

/* O hover/focus/active conserva exatamente o mesmo recorte arredondado
   do botão, inclusive nos pseudo-elementos de brilho. */
.button,
.button:hover,
.button:focus,
.button:focus-visible,
.button:focus-within,
.button:active,
.home__header .button,
.home__header .button:hover,
.hero-panel-actions__action,
.hero-panel-actions__action:hover,
.game-details__description-toggle,
.game-details__description-toggle:hover,
.filter-item,
.filter-item:hover,
.badge,
.badge:hover {
  border-radius: var(--steamshit-cut-control, 10px) !important;
}

.button::before,
.button::after,
.button:hover::before,
.button:hover::after,
.home__header .button::before,
.home__header .button::after {
  border-radius: inherit !important;
}

.button,
.home__header .button,
.hero-panel-actions__action,
.game-details__description-toggle,
.filter-item,
.badge {
  overflow: hidden !important;
  isolation: isolate;
}

/* ========================================================================== */
/* STEAMSHIT 6.7 — FIX REAL: FOCUS RING ARREDONDADO + BUSCA SEM CLIPPING      */
/* ========================================================================== */

/*
   X da questão:
   1) havia regras globais de :focus-visible usando `outline`, que no Chromium/
      Electron pode ser desenhado como um retângulo mesmo quando o controle tem
      border-radius;
   2) a correção anterior deixou .header__search com overflow:hidden, então o
      foco do input interno podia ser recortado no topo.

   Solução: remover o outline quadrado desses controles e desenhar o foco com
   box-shadow, que acompanha o border-radius. A busca fica overflow:visible e
   o foco é desenhado no próprio contêiner via :focus-within.
*/

/* Busca: nunca corta o anel superior e nunca muda de geometria. */
.header,
.container__content > .header {
  overflow: visible !important;
}

.header__search,
.header__search:hover,
.header__search:focus,
.header__search:focus-visible,
.header__search:focus-within {
  border-radius: 12px !important;
  overflow: visible !important;
  outline: none !important;
  outline-offset: 0 !important;
  transform: none !important;
}

/* Caso .header__search seja um wrapper e o input real esteja dentro dele. */
.header__search input,
.header__search input:hover,
.header__search input:focus,
.header__search input:focus-visible {
  border-radius: inherit !important;
  outline: none !important;
  outline-offset: 0 !important;
  transform: none !important;
}

/* O anel de foco agora segue os cantos arredondados, sem retângulo externo. */
.header__search:focus,
.header__search:focus-visible,
.header__search:focus-within {
  border-color: var(--market-accent, var(--steam-accent)) !important;
  box-shadow:
    0 0 0 2px rgba(26, 159, 255, 0.52),
    0 10px 24px rgba(0, 0, 0, 0.20) !important;
}

/* Botões arredondados: hover/foco/clique mantêm UMA única silhueta. */
.button,
.button:hover,
.button:focus,
.button:focus-visible,
.button:focus-within,
.button:active,
.home__header .button,
.home__header .button:hover,
.home__header .button:focus-visible,
.hero-panel-actions__action,
.hero-panel-actions__action:hover,
.hero-panel-actions__action:focus-visible,
.game-details__description-toggle,
.game-details__description-toggle:hover,
.game-details__description-toggle:focus-visible,
.filter-item,
.filter-item:hover,
.filter-item:focus-visible,
.badge,
.badge:hover,
.badge:focus-visible {
  border-radius: var(--steamshit-cut-control, 12px 4px 12px 4px) !important;
}

/* Remove especificamente o outline retangular global que estava aparecendo
   por fora dos botões arredondados. O box-shadow abaixo respeita o radius. */
.button:focus-visible,
.home__header .button:focus-visible,
.hero-panel-actions__action:focus-visible,
.game-details__description-toggle:focus-visible,
.filter-item:focus-visible,
.badge:focus-visible {
  outline: none !important;
  outline-offset: 0 !important;
  box-shadow:
    0 0 0 2px rgba(26, 159, 255, 0.50),
    0 11px 24px rgba(0, 0, 0, 0.29) !important;
}

/* O brilho de hover também é recortado pela mesma forma do botão. */
.button,
.home__header .button,
.hero-panel-actions__action,
.game-details__description-toggle,
.filter-item,
.badge {
  overflow: hidden !important;
  isolation: isolate;
}

.button::before,
.button::after,
.button:hover::before,
.button:hover::after,
.button:focus-visible::before,
.button:focus-visible::after,
.home__header .button::before,
.home__header .button::after {
  border-radius: inherit !important;
}


/* ========================================================================== */
/* STEAMSHIT 6.8 — FIX EXATO DA BUSCA DA SIDEBAR                              */
/* ========================================================================== */

/*
   Confirmado pelo DOM do Hydra:
   .sidebar__search-row
     > .text-field-container
       > .text-field-container__text-field-wrapper
         > .text-field-container__text-field.text-field-container__text-field--dark
           > input.text-field-container__text-field-input

   O retângulo azul não era o .header__search. Era o INPUT real da busca da
   sidebar recebendo o :focus-visible global, enquanto o input não tinha
   border-radius próprio. O campo visual (pai) era arredondado, mas o anel do
   input continuava retangular.

   A correção abaixo é propositalmente limitada à busca da sidebar.
*/

.sidebar__search-row .text-field-container,
.sidebar__search-row .text-field-container__text-field-wrapper,
.sidebar__search-row .text-field-container__text-field,
.sidebar__search-row .text-field-container__text-field--dark,
.sidebar__search-row .text-field-container__text-field-input {
  border-radius: 12px !important;
}

/* O input interno é transparente: ele não deve desenhar um segundo foco
   retangular por cima do contêiner arredondado. */
.sidebar__search-row .text-field-container__text-field-input,
.sidebar__search-row .text-field-container__text-field-input:hover,
.sidebar__search-row .text-field-container__text-field-input:focus,
.sidebar__search-row .text-field-container__text-field-input:focus-visible,
.sidebar__search-row .text-field-container__text-field-input:active {
  outline: none !important;
  outline-offset: 0 !important;
  box-shadow: none !important;
  border-radius: 12px !important;
  transform: none !important;
}

/* Hover mantém exatamente a mesma silhueta arredondada do campo em repouso. */
.sidebar__search-row .text-field-container__text-field--dark:hover {
  border-radius: 12px !important;
  transform: none !important;
}

/* Um único anel de foco, desenhado no elemento visual arredondado. */
.sidebar__search-row .text-field-container__text-field--dark:focus,
.sidebar__search-row .text-field-container__text-field--dark:focus-visible,
.sidebar__search-row .text-field-container__text-field--dark:focus-within {
  outline: none !important;
  outline-offset: 0 !important;
  border-radius: 12px !important;
  transform: none !important;
  border-color: var(--market-accent, var(--steam-accent)) !important;
  box-shadow:
    0 0 0 2px rgba(26, 159, 255, 0.52),
    0 8px 18px rgba(0, 0, 0, 0.18) !important;
}

/* Garante que wrappers nativos do Hydra não desenhem uma segunda moldura. */
.sidebar__search-row .text-field-container:focus-within,
.sidebar__search-row .text-field-container__text-field-wrapper:focus-within {
  outline: none !important;
  box-shadow: none !important;
  border-radius: 12px !important;
}

/* ========================================================================== */
/* STEAMSHIT 6.9 — DOWNLOAD GRID FEATHER + RODAPÉ LOCALIZADO                  */
/* ========================================================================== */

:root {
  --downloads-grid-blend: clamp(120px, 16vh, 180px);
  --downloads-grid-overlap: clamp(60px, 8vh, 90px);
}

/*
   Na página de downloads, a microtrama antes terminava exatamente junto com
   a altura variável da fila. Agora ela vive em uma camada própria, atravessa
   suavemente essa borda e desaparece sobre o deck em perspectiva. O conteúdo
   permanece totalmente nítido: somente a textura recebe a fusão.
*/
.downloads__container {
  isolation: isolate;
  background-image: none !important;
}

.downloads__container::before {
  content: "";
  position: absolute;
  inset: 0 0 calc(0px - var(--downloads-grid-overlap));
  z-index: -1;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(103, 193, 245, 0.036) 1px, transparent 1px),
    linear-gradient(90deg, rgba(103, 193, 245, 0.03) 1px, transparent 1px),
    radial-gradient(circle at 1px 1px, rgba(103, 193, 245, 0.075) 1px, transparent 1.4px),
    radial-gradient(circle at 74% 6%, rgba(26, 159, 255, 0.052), transparent 26%);
  background-position: 0 0, 0 0, 0 0, 0 0;
  background-size: 72px 72px, 72px 72px, 72px 72px, 100% 100%;
  filter: blur(0.45px);
  opacity: 0.98;
  -webkit-mask-image: linear-gradient(
    to bottom,
    #000 0,
    #000 calc(100% - var(--downloads-grid-blend)),
    rgba(0, 0, 0, 0.72) calc(100% - var(--downloads-grid-overlap)),
    transparent 100%
  );
  mask-image: linear-gradient(
    to bottom,
    #000 0,
    #000 calc(100% - var(--downloads-grid-blend)),
    rgba(0, 0, 0, 0.72) calc(100% - var(--downloads-grid-overlap)),
    transparent 100%
  );
  transform: translateZ(0);
}

