/* ========================================================================
   INTRO DE ABERTURA — HYDRA / STEAM
   Fundo do launcher desfocado -> logo entra -> logo sai -> launcher fica nítido
   ======================================================================== */

html::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: 2147483645;
  pointer-events: none;

  /* precisa ser levemente transparente para o backdrop-filter desfocar o app */
  background: rgba(5, 11, 17, 0.34);
  -webkit-backdrop-filter: blur(20px) brightness(0.62);
  backdrop-filter: blur(20px) brightness(0.62);

  animation: hydraIntroBackdrop 2.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

html::after {
  content: "";
  position: fixed;
  left: calc(50% + 28px);
  top: calc(50% - 32px);
  width: clamp(185px, 24vw, 320px);
  aspect-ratio: 1 / 1;
  z-index: 2147483646;
  pointer-events: none;

  background-image: url("https://i.ibb.co/jPjdJtFj/Chat-GPT-Image-4-de-jun-de-2025-15-58-52-removebg-preview.png");
  background-position: center;
  background-repeat: no-repeat;
  background-size: contain;

  opacity: 0;
  transform: translate(-50%, -50%) scale(0.88);
  filter:
    drop-shadow(0 0 12px rgba(26, 159, 255, 0.28))
    drop-shadow(0 0 30px rgba(103, 193, 245, 0.10));

  animation: hydraIntroLogo 2.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

@keyframes hydraIntroLogo {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.88);
    filter:
      drop-shadow(0 0 0 rgba(26, 159, 255, 0))
      brightness(0.90);
  }

  18% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    filter:
      drop-shadow(0 0 14px rgba(26, 159, 255, 0.30))
      drop-shadow(0 0 34px rgba(103, 193, 245, 0.12))
      brightness(1);
  }

  55% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  78% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(1.055);
    filter:
      drop-shadow(0 0 22px rgba(26, 159, 255, 0.18))
      brightness(1.04);
  }

  100% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(1.055);
  }
}

@keyframes hydraIntroBackdrop {
  0%,
  55% {
    opacity: 1;
    background: rgba(5, 11, 17, 0.34);
    -webkit-backdrop-filter: blur(20px) brightness(0.62);
    backdrop-filter: blur(20px) brightness(0.62);
  }

  72% {
    opacity: 1;
    background: rgba(5, 11, 17, 0.18);
    -webkit-backdrop-filter: blur(11px) brightness(0.78);
    backdrop-filter: blur(11px) brightness(0.78);
  }

  100% {
    opacity: 0;
    background: rgba(5, 11, 17, 0);
    -webkit-backdrop-filter: blur(0) brightness(1);
    backdrop-filter: blur(0) brightness(1);
  }
}

/* ========================================================================
   INTRO — LABIRINTITE / CYBERPUNK REFINADO
   A INTRO HYDRA/STEAM ACIMA NÃO FOI ALTERADA.

   Direção visual:
   - menos "preset/Canva" e mais assinatura de marca;
   - vidro quase incolor, sem blur retangular e sem aura;
   - tipografia angular com inclinação constante;
   - revelação limpa + reflexo estreito de uma única passagem;
   - movimento final continua sincronizado com a logo Hydra/Steam.
   ======================================================================== */

body::after {
  content: "Labirintite";
  position: fixed;
  left: calc(50% - 8px);
  top: calc(50% - 32px + clamp(108px, 11.5vw, 148px));
  z-index: 2147483647;
  pointer-events: none;
  user-select: none;

  /* Mais "marca" e menos fonte de interface. */
  font-family: "Bruno Ace SC", "Tektur", "Arial Black", sans-serif;
  font-size: clamp(48px, 4.8vw, 72px);
  font-style: normal;
  font-weight: 400;
  line-height: 0.94;
  letter-spacing: 0.085em;
  white-space: nowrap;
  text-rendering: geometricPrecision;

  color: transparent;
  -webkit-text-fill-color: transparent;

  /*
     Duas camadas RECORTADAS NAS LETRAS:
     1) corpo de vidro neutro e muito discreto;
     2) lâmina de luz estreita que atravessa uma única vez.
     Não existe glow fora dos glifos.
  */
  background-image:
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.20) 0%,
      rgba(244, 249, 252, 0.10) 42%,
      rgba(220, 231, 238, 0.075) 56%,
      rgba(255, 255, 255, 0.15) 100%
    ),
    linear-gradient(
      104deg,
      transparent 0%,
      transparent 43%,
      rgba(255, 255, 255, 0.06) 46%,
      rgba(255, 255, 255, 0.44) 48.4%,
      rgba(255, 255, 255, 0.98) 50%,
      rgba(226, 244, 255, 0.55) 51.7%,
      rgba(255, 255, 255, 0.08) 54%,
      transparent 57%,
      transparent 100%
    );

  background-size: 100% 100%, 270% 100%;
  background-position: 50% 50%, 135% 50%;
  background-repeat: no-repeat;
  -webkit-background-clip: text;
  background-clip: text;

  /* Borda de refração mínima — não vira outline branco. */
  -webkit-text-stroke: 0.36px rgba(255, 255, 255, 0.24);

  text-shadow: none !important;
  box-shadow: none !important;
  filter: contrast(1.04) saturate(0.45) !important;

  opacity: 0;
  clip-path: inset(0 100% 0 0);
  transform-origin: 50% 50%;
  transform: translate3d(-50%, 0, 0) skewX(-7deg) scale(0.88);
  backface-visibility: hidden;
  will-change: opacity, clip-path, background-position, transform;

  animation:
    labirintiteRefinedSurface 2.8s cubic-bezier(0.22, 1, 0.36, 1) forwards,
    labirintiteRefinedHydraMotion 2.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

@keyframes labirintiteRefinedSurface {
  /* Nome não compete com o primeiro instante da logo. */
  0%, 16% {
    clip-path: inset(0 100% 0 0);
    background-position: 50% 50%, 135% 50%;
  }

  /* Revelação seca e controlada, sem "wipe de PowerPoint" demorado. */
  22% {
    clip-path: inset(0 92% 0 0);
    background-position: 50% 50%, 135% 50%;
  }

  41% {
    clip-path: inset(0 0 0 0);
    background-position: 50% 50%, 135% 50%;
  }

  49% {
    clip-path: inset(0 0 0 0);
    background-position: 50% 50%, 135% 50%;
  }

  /* Reflexo curto; atravessa e vai embora, sem pulsar. */
  64% {
    clip-path: inset(0 0 0 0);
    background-position: 50% 50%, -35% 50%;
  }

  100% {
    clip-path: inset(0 0 0 0);
    background-position: 50% 50%, -35% 50%;
  }
}

/*
   Mesma coreografia da logo Hydra/Steam:
   0.88 -> 1 -> 1.055 e fade nos MESMOS pontos.
   O skew é constante, então funciona como identidade da palavra,
   não como um efeito extra de animação.
*/
@keyframes labirintiteRefinedHydraMotion {
  0% {
    opacity: 0;
    transform: translate3d(-50%, 0, 0) skewX(-7deg) scale(0.88);
  }

  18% {
    opacity: 1;
    transform: translate3d(-50%, 0, 0) skewX(-7deg) scale(1);
  }

  55% {
    opacity: 1;
    transform: translate3d(-50%, 0, 0) skewX(-7deg) scale(1);
  }

  78% {
    opacity: 0;
    transform: translate3d(-50%, 0, 0) skewX(-7deg) scale(1.055);
  }

  100% {
    opacity: 0;
    transform: translate3d(-50%, 0, 0) skewX(-7deg) scale(1.055);
  }
}

