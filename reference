}

.sidebar__menu-item--active {
  color: #ffffff;
  background: linear-gradient(90deg, rgba(65, 122, 155, 0.82), rgba(42, 71, 94, 0.6) 72%, rgba(35, 38, 46, 0.3)) !important;
  border-color: rgba(103, 193, 245, 0.22);
}

.sidebar__menu-item--active i,
.sidebar__menu-item--active svg,
.sidebar__help-button-icon {
  color: var(--steam-accent-soft);
}

.sidebar__menu-item::after {
  background: linear-gradient(105deg, transparent 18%, rgba(103, 193, 245, 0.11) 48%, transparent 76%);
}

@keyframes steamshit-active-breathe {
