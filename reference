  outline: none !important;
  outline-offset: 0 !important;
  box-shadow: none !important;
  background-color: transparent !important;
  background-clip: padding-box !important;
}

/* Um único anel acompanha a gota inteira, inclusive no modal de opções. */
.text-field-container__text-field:focus,
.text-field-container__text-field:focus-visible,
.text-field-container__text-field:focus-within,
.text-field-container__text-field--dark:focus-within,
