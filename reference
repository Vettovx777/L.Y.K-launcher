    box-shadow: inset 4px 0 0 #67c1f5, 0 10px 24px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(26, 159, 255, 0.1);
  }
}

.sidebar-profile__button,
.sidebar-profile__friends-button {
