  }
}

/* ========================================================================== */
/* STEAMSHIT 7.6 — LIBRARY PHYSICAL COVER GLAZE                              */
/* ========================================================================== */

/*
   Uma película óptica exclusiva da Biblioteca. O reflexo curvo lembra o
   plástico de uma capa física sob a luz, enquanto o brilho de borda permanece
   contido no recorte do card e não interfere nos controles sobre a imagem.
*/
.library-game-card__wrapper::after,
.library-game-card-large::after {
  content: "";
  position: absolute;
  inset: -1px;
  z-index: 1;
  pointer-events: none;
  opacity: 0.14;
  border: 1px solid rgba(216, 244, 255, 0.04);
  background:
    radial-gradient(
      88% 58% at 14% -10%,
      rgba(255, 255, 255, 0.22) 0%,
      rgba(185, 232, 255, 0.1) 27%,
      rgba(103, 193, 245, 0.035) 45%,
      transparent 68%
    ),
    linear-gradient(
      112deg,
      transparent 17%,
      rgba(255, 255, 255, 0.025) 31%,
      rgba(216, 244, 255, 0.13) 43%,
      rgba(103, 193, 245, 0.055) 49%,
      transparent 61%
    );
  background-size: 118% 118%, 170% 100%;
  background-position: 8% -8%, -115% 0;
  background-repeat: no-repeat;
  mix-blend-mode: screen;
  transform: translate3d(-2%, -1%, 0) scale(1.025);
  transition:
    opacity 240ms ease,
    border-color 300ms ease,
    background-position 760ms var(--cover-response-ease),
    transform 620ms var(--cover-response-ease);
}

@media (hover: hover) and (pointer: fine) {
  .library-game-card__wrapper:is(:hover, :focus-visible, :focus-within)::after,
  .library-game-card-large:is(:hover, :focus-visible, :focus-within)::after {
    opacity: 0.78;
    border-color: rgba(216, 244, 255, 0.22);
    background-position: 22% 5%, 115% 0;
    transform: translate3d(2.5%, 1.5%, 0) scale(1.045);
  }

  .library-game-card__wrapper:is(:hover, :focus-visible, :focus-within),
  .library-game-card-large:is(:hover, :focus-visible, :focus-within) {
    box-shadow:
      inset 0 0 0 1px rgba(235, 249, 255, 0.24),
      inset 0 0 24px rgba(103, 193, 245, 0.055),
      0 14px 30px rgba(0, 0, 0, 0.38),
      0 0 24px rgba(26, 159, 255, 0.15);
  }

  /*
     A arte de fundo dos clássicos continua ampliada, mas nunca fica crua.
     O blur curto mascara pixels e compressão e ainda permite reconhecer a
     imagem, como um fundo fotográfico fora de foco.
  */
  .library-game-card__wrapper:is(:hover, :focus-visible, :focus-within)
    .library-game-card__classics-backdrop {
    transform: scale(1.28) !important;
    filter:
      blur(8px)
      saturate(1.14)
      contrast(1.025)
      brightness(0.9) !important;
  }

  .library-game-card-large--classics:is(:hover, :focus-visible, :focus-within)
    .library-game-card-large__background {
    transform: scale(1.22) !important;
    filter:
      blur(9px)
      saturate(1.14)
      contrast(1.025)
      brightness(0.9) !important;
  }
}

@media (prefers-reduced-motion: reduce) {
  .library-game-card__wrapper::after,
  .library-game-card-large::after,
  .library-game-card__wrapper:hover::after,
  .library-game-card-large:hover::after {
    background-position: 12% 0, 50% 0;
    transform: none !important;
    transition: none !important;
  }

  .library-game-card__wrapper:hover .library-game-card__classics-backdrop {
    transform: scale(1.25) !important;
    filter: blur(16px) saturate(1.1) !important;
  }

  .library-game-card-large--classics:hover .library-game-card-large__background {
    transform: scale(1.2) !important;
    filter: blur(18px) saturate(1.1) !important;
  }
}

/* ========================================================================== */
/* STEAMSHIT 7.7 — CLASSICS BACKDROP SAFETY + FINAL COMPATIBILITY PASS       */
/* ========================================================================== */

/*
   O catálogo clássico usa duas imagens independentes. A arte ampliada fica
   permanentemente desfocada; somente a capa física central permanece nítida.
   Seletores explícitos evitam que futuras mudanças na ordem do DOM troquem os
   papéis das duas camadas novamente.
*/
.game-item-classics__cover-backdrop {
  transform: scale(1.25);
  filter: blur(14px) saturate(1.1);
  opacity: 0.65;
}

.game-item-classics__cover-image {
  filter: saturate(1) contrast(1);
  box-shadow:
    0 11px 18px rgba(0, 0, 0, 0.28),
    0 3px 6px rgba(0, 0, 0, 0.3),
    0 0 0 1px rgba(216, 244, 255, 0.06);
}

/* Película discreta sobre o conjunto, abaixo dos chips e botões. */
.game-item-classics__cover::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  opacity: 0.1;
  background:
    radial-gradient(75% 82% at 18% -18%, rgba(255, 255, 255, 0.18), transparent 62%),
    linear-gradient(112deg, transparent 28%, rgba(216, 244, 255, 0.11) 46%, transparent 63%);
  background-size: 115% 115%, 180% 100%;
  background-position: 0 0, -120% 0;
  background-repeat: no-repeat;
  mix-blend-mode: screen;
  transition:
    opacity 240ms ease,
    background-position 720ms var(--cover-response-ease);
}

@media (hover: hover) and (pointer: fine) {
  .game-item-classics:is(:hover, :focus-within)
    .game-item-classics__cover-backdrop {
    transform: scale(1.28) !important;
    filter:
      blur(9px)
      saturate(1.12)
      contrast(1.015)
      brightness(0.86) !important;
    opacity: 0.68;
  }

  .game-item-classics:is(:hover, :focus-within)
    .game-item-classics__cover-image {
    transform: scale(1.035) translate3d(0, -0.35%, 0);
    filter: saturate(1.055) contrast(1.02) brightness(1.03);
    box-shadow:
      0 15px 28px rgba(0, 0, 0, 0.42),
      0 5px 10px rgba(0, 0, 0, 0.34),
      0 0 0 1px rgba(235, 249, 255, 0.24),
      0 0 18px rgba(26, 159, 255, 0.15);
  }

  .game-item-classics:is(:hover, :focus-within)
    .game-item-classics__cover::after {
    opacity: 0.42;
    background-position: 12% 4%, 115% 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .game-item-classics__cover::after,
  .game-item-classics:hover .game-item-classics__cover::after {
    background-position: 8% 0, 50% 0;
    transition: none !important;
  }

  .game-item-classics:hover .game-item-classics__cover-backdrop {
    transform: scale(1.25) !important;
    filter: blur(14px) saturate(1.1) !important;
    opacity: 0.65;
  }

  .game-item-classics:hover .game-item-classics__cover-image {
    transform: none !important;
  }
}

/* ========================================================================== */
/* STEAMSHIT 7.8 — INTERACTION SILHOUETTE: ONE CONTROL, ONE SHAPE            */
/* ========================================================================== */

/*
   O elemento interno de TextField recebia o outline global do Chromium e
   desenhava um retângulo dentro da moldura arredondada. A moldura passa a ser
   a única responsável por hover/foco; input e textarea ficam transparentes.
*/
.text-field-container__text-field,
.text-field-container__text-field--dark,
.text-field-container__text-field--primary,
.text-field-container__text-field:hover,
.text-field-container__text-field:focus,
.text-field-container__text-field:focus-visible,
.text-field-container__text-field:focus-within {
  border-radius: var(--steamshit-cut-control) !important;
  background-clip: padding-box !important;
  overflow: hidden;
  isolation: isolate;
}

.text-field-container__text-field-input,
.text-field-container__text-field-input:hover,
.text-field-container__text-field-input:focus,
.text-field-container__text-field-input:focus-visible,
.text-field-container__text-field-input:active,
.text-field-container__text-field > input,
.text-field-container__text-field > textarea {
