  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07), var(--market-shadow-low);
  transition:
    background-position var(--motion-normal),
    background-color var(--motion-fast),
    border-color var(--motion-fast),
    color var(--motion-fast),
    box-shadow var(--motion-normal),
    transform var(--motion-normal);
}

.button:not(.button--icon) {
  border-radius: 12px 4px 12px 4px;
}

.hero-panel-actions__action,
.game-details__description-toggle {
