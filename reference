/*
   Notificação flutuante de conquista — componente independente da página de
   achievements. A cor de sinalização muda pelo estado real entregue pelo
   Hydra, enquanto material, recorte e tipografia permanecem consistentes.
*/
.achievement-notification {
  /* Valores locais: esta UI vive em Shadow DOM e não deve depender do :root. */
  --steamshit-cut-notification: 22px 4px 22px 4px;
  --steamshit-cut-control: 12px 4px 12px 4px;
  --steamshit-cut-thumbnail: 8px 3px 8px 4px;
  --achievement-relay-ease: cubic-bezier(0.22, 1, 0.36, 1);
  --achievement-relay-rgb: 103, 193, 245;
  --achievement-relay-bright: #b9e8ff;
  --achievement-relay-deep: #176b9b;
}

.achievement-notification--rare {
  --achievement-relay-rgb: 232, 173, 21;
  --achievement-relay-bright: #ffe39a;
  --achievement-relay-deep: #8f5e08;
}

.achievement-notification--platinum {
  --achievement-relay-rgb: 21, 232, 214;
  --achievement-relay-bright: #c9fff8;
  --achievement-relay-deep: #087766;
}

.achievement-notification--hidden {
  --achievement-relay-rgb: 139, 151, 163;
  --achievement-relay-bright: #d7dee5;
  --achievement-relay-deep: #44515d;
}

.achievement-notification__outer-container {
  border: 1px solid rgba(var(--achievement-relay-rgb), 0.58) !important;
  border-radius: var(--steamshit-cut-feature) !important;
  background:
    linear-gradient(135deg, rgba(var(--achievement-relay-rgb), 0.22), transparent 34%),
    #0a1118 !important;
  background-clip: padding-box !important;
  overflow: hidden !important;
  isolation: isolate;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.075),
    0 16px 38px rgba(0, 0, 0, 0.48),
    0 0 22px rgba(var(--achievement-relay-rgb), 0.13) !important;
  animation: steamshit-achievement-shell-in 1180ms var(--achievement-relay-ease) both;
}

.achievement-notification__container {
  position: relative;
  isolation: isolate;
  border: 0 !important;
  border-radius: inherit !important;
  background:
    radial-gradient(circle at 8% 18%, rgba(var(--achievement-relay-rgb), 0.17), transparent 34%),
    linear-gradient(112deg, rgba(36, 60, 79, 0.98) 0%, rgba(20, 34, 46, 0.99) 54%, rgba(9, 16, 23, 1) 100%) !important;
  overflow: hidden !important;
  box-shadow:
    inset 3px 0 0 rgba(var(--achievement-relay-rgb), 0.9),
    inset 0 1px 0 rgba(255, 255, 255, 0.045) !important;
}

/* Reflexo curto de desbloqueio: luminoso, mas sem animação contínua pesada. */
.achievement-notification__container::before {
  content: "";
  position: absolute;
  z-index: 0;
  top: -55%;
  bottom: -55%;
  left: -32%;
  width: 18%;
  pointer-events: none;
  opacity: 0;
  border-radius: inherit;
  background: linear-gradient(90deg, transparent, rgba(var(--achievement-relay-rgb), 0.38), transparent);
  filter: blur(7px);
  transform: skewX(-18deg);
  animation: steamshit-achievement-relay 820ms 1120ms var(--achievement-relay-ease) both;
}

.achievement-notification__outer-container::after {
  content: "";
  position: absolute;
  z-index: 3;
  right: 10px;
  bottom: 0;
  left: 10px;
  height: 2px;
  pointer-events: none;
  border-radius: 999px;
  opacity: 0.88;
  background: linear-gradient(90deg, transparent, rgba(var(--achievement-relay-rgb), 0.88) 52%, transparent);
  box-shadow: 0 0 12px rgba(var(--achievement-relay-rgb), 0.34);
}

.achievement-notification__icon {
  border: 1px solid rgba(var(--achievement-relay-rgb), 0.72) !important;
  border-radius: var(--steamshit-cut-thumbnail) !important;
  outline: 0 !important;
  background-clip: padding-box !important;
  box-shadow:
    0 8px 18px rgba(0, 0, 0, 0.34),
    0 0 14px rgba(var(--achievement-relay-rgb), 0.2) !important;
}

.achievement-notification__title {
  color: #f5f8fa !important;
  letter-spacing: 0.01em;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.72), 0 0 12px rgba(var(--achievement-relay-rgb), 0.09);
}

.achievement-notification__description {
  color: #b8c7d3 !important;
}

.achievement-notification__chip {
  color: #ffffff !important;
  border: 1px solid rgba(var(--achievement-relay-rgb), 0.76) !important;
  border-radius: var(--steamshit-cut-control) !important;
  background:
    linear-gradient(135deg, rgba(var(--achievement-relay-rgb), 0.44), rgba(var(--achievement-relay-rgb), 0.16)),
    #14212c !important;
  background-clip: padding-box !important;
  overflow: hidden;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.13),
    0 7px 18px rgba(0, 0, 0, 0.32),
    0 0 14px rgba(var(--achievement-relay-rgb), 0.18) !important;
}

.achievement-notification__chip__label {
  color: #ffffff !important;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.62);
}

.achievement-notification__chip__icon path {
  fill: var(--achievement-relay-bright) !important;
}

.achievement-notification__trophy-overlay {
  background: linear-gradient(135deg, var(--achievement-relay-bright), var(--achievement-relay-deep)) !important;
  filter: drop-shadow(0 0 7px rgba(var(--achievement-relay-rgb), 0.34));
}

@keyframes steamshit-achievement-relay {
  0% {
    opacity: 0;
    transform: translate3d(0, 0, 0) skewX(-18deg);
  }
  34% {
    opacity: 0.72;
  }
  100% {
    opacity: 0;
    transform: translate3d(440px, 0, 0) skewX(-18deg);
  }
}

@keyframes steamshit-achievement-shell-in {
  0% {
    width: 80px;
    opacity: 0;
    transform: scale(0.94);
  }
  32% {
    width: 80px;
    opacity: 1;
    transform: scale(1);
  }
  52% {
    width: 80px;
  }
