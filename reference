}

.game-options-modal__sidebar-button,
.disc-field__trigger,
.disc-field__option,
.drive-card,
.sidebar__menu-item-button {
  overflow: hidden;
  isolation: isolate;
}

.sidebar__menu-item-button {
  border-radius: inherit !important;
  background-clip: padding-box !important;
}

/* Pseudos de brilho seguem a silhueta da superfície que os contém. */
.game-options-modal__sidebar-button::before,
.game-options-modal__sidebar-button::after,
.disc-field__trigger::before,
.disc-field__trigger::after,
.disc-field__option::before,
.disc-field__option::after,
.drive-card::before,
.drive-card::after,
.sidebar__menu-item-button::before,
.sidebar__menu-item-button::after {
