/* Verde Steam reservado a ações positivas/execução. */
.game-details__play-button,
.game-details__launch-button,
.button--success {
  color: #ffffff;
  background: linear-gradient(135deg, #75b022, #588a1b) !important;
  border-color: rgba(201, 255, 201, 0.2) !important;
}

.game-details__play-button:hover,
.game-details__launch-button:hover,
.button--success:hover {
  background: linear-gradient(135deg, #8ed629, #6aa621) !important;
  border-color: rgba(201, 255, 201, 0.38) !important;
}

.button:disabled,
button:disabled {
  color: #67707b;
  filter: saturate(0.45);
  opacity: 0.62;
}

/* Campos e menus. */
input,
select,
textarea,
.select-field__option {
  color: #dcdedf;
  caret-color: var(--steam-accent-soft);
}

input::placeholder,
textarea::placeholder {
  color: #8b929a;
  opacity: 0.88;
}

.select-field__label {
  color: #8b929a;
}

.select-field__option {
  background: #23262e;
  border-color: rgba(103, 193, 245, 0.14);
}

.text-field-container__text-field--dark:hover,
.text-field-container__text-field--primary:hover {
  background: linear-gradient(145deg, rgba(61, 68, 80, 0.86), rgba(35, 38, 46, 0.96)) !important;
  border-color: rgba(103, 193, 245, 0.3);
}

.text-field-container__text-field--dark:focus,
.text-field-container__text-field--dark:focus-within,
.text-field-container__text-field--primary:focus,
.text-field-container__text-field--primary:focus-within {
  border-color: var(--steam-accent);
  box-shadow: 0 0 0 3px rgba(26, 159, 255, 0.14);
}

.checkbox-field__checkbox,
input[type="checkbox"],
input[type="radio"],
progress {
  accent-color: var(--steam-accent);
}

.checkbox-field__checkbox {
  background-color: #23262e;
  border-color: rgba(103, 193, 245, 0.34);
}

.context-menu,
.context-menu__submenu,
.dropdown-menu__content {
  color: #dcdedf;
  background: linear-gradient(145deg, #3d4450 0%, #23262e 64%, #171d25 100%);
  border-color: rgba(103, 193, 245, 0.16);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.035),
    0 18px 42px rgba(0, 0, 0, 0.44);
}

.context-menu__item:hover,
.dropdown-menu__item:hover {
  color: #ffffff;
  background-color: rgba(65, 122, 155, 0.72);
}

.dropdown-menu__separator {
  background-color: rgba(103, 193, 245, 0.16);
}

.modal {
  color: #dcdedf;
  background:
    radial-gradient(circle at 82% 0%, rgba(26, 159, 255, 0.1), transparent 34%),
    linear-gradient(145deg, rgba(42, 71, 94, 0.96), rgba(23, 29, 37, 0.99)) !important;
  border-color: rgba(103, 193, 245, 0.16);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.035),
    0 24px 64px rgba(0, 0, 0, 0.5);
}

.toast,
.achievement-notification__container {
  color: #dcdedf;
  background: linear-gradient(145deg, #2a475e 0%, #23262e 62%, #171d25 100%);
  border-color: rgba(103, 193, 245, 0.22);
  box-shadow: 0 18px 42px rgba(0, 0, 0, 0.42);
}

.achievement-notification__title,
.achievement-notification__chip__label {
  color: #ffffff;
}

.achievement-notification__description {
  color: #b8bcbf;
}

.achievement-notification__chip {
  color: #dcdedf;
  background: #23262e;
  border-color: #417a9b;
}

.achievement-notification__chip__icon path {
  fill: #67c1f5;
}

.achievement-notification--rare .achievement-notification__container,
.achievement-notification--platinum .achievement-notification__container {
  background: linear-gradient(145deg, #3d6c8d 0%, #2a475e 48%, #171d25 100%);
  border-color: #67c1f5;
}

.profile-avatar,
.profile-hero__avatar-button {
  border-color: rgba(103, 193, 245, 0.38);
  box-shadow: 0 0 0 1px rgba(26, 159, 255, 0.08), 0 12px 28px rgba(0, 0, 0, 0.3);
}

.profile-avatar::before {
  border-color: rgba(103, 193, 245, 0.42);
  box-shadow: 0 0 18px rgba(26, 159, 255, 0.16);
}

.profile-picture:hover,
.profile-banner:hover {
  box-shadow: 0 8px 22px rgba(26, 159, 255, 0.18);
}

.profile-text:hover {
  color: #ffffff;
  text-shadow: 0 0 10px rgba(103, 193, 245, 0.2);
}

.game-item:hover,
.download-group__item:hover {
  box-shadow: -7px 13px 30px rgba(0, 0, 0, 0.34), 0 0 0 1px rgba(26, 159, 255, 0.07);
}

.game-card:hover {
  box-shadow: -7px 15px 38px rgba(0, 0, 0, 0.42), 0 0 0 1px rgba(26, 159, 255, 0.08);
}

.sidebar__handle {
  background: linear-gradient(90deg, transparent, rgba(103, 193, 245, 0.24));
}

@keyframes titlebarGlow {
  0%, 100% {
    filter: drop-shadow(0 0 4px rgba(26, 159, 255, 0.15)) brightness(1);
  }
  50% {
    filter: drop-shadow(0 0 9px rgba(103, 193, 245, 0.34)) brightness(1.05);
  }
}

@keyframes pulseGlow {
  0%, 100% {
    box-shadow: 0 0 4px rgba(26, 159, 255, 0.24);
  }
  50% {
    box-shadow: 0 0 13px rgba(103, 193, 245, 0.52);
  }
}

@keyframes profileAvatarPulse {
  0% {
    border-color: rgba(65, 122, 155, 0.36);
    box-shadow: 0 0 8px rgba(26, 159, 255, 0.1);
  }
  100% {
    border-color: rgba(103, 193, 245, 0.5);
    box-shadow: 0 0 18px rgba(26, 159, 255, 0.2);
  }
}

/* Rolagem e foco compartilham o mesmo azul de ação. */
::-webkit-scrollbar-track {
  background-color: rgba(14, 20, 27, 0.58);
}

::-webkit-scrollbar-thumb {
  background: linear-gradient(to bottom, #417a9b, #2a475e);
}

::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(to bottom, #67c1f5, #1a9fff);
}

.sidebar__menu-item:focus-visible,
.sidebar-section__button:focus-visible,
.sidebar-profile__button:focus-visible,
.sidebar-profile__friends-button:focus-visible,
.button:focus-visible,
button:focus-visible,
a:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline-color: var(--steam-accent-soft);
  box-shadow: 0 0 0 3px rgba(26, 159, 255, 0.16);
}

/* ========================================================================== */
/* STEAMSHIT 3.2 — SHELL CONTÍNUO + MOTION PREMIUM                         */
/*
   A titlebar, o header e o corpo passam a compartilhar exatamente a mesma
   superfície horizontal. As animações usam prioritariamente transform e
   opacity para manter a resposta leve, mesmo com muitos cards na tela.
*/

:root {
  --shell-surface: linear-gradient(90deg, #142331 0%, #111b26 48%, #0f1923 100%);
  --motion-snap: 150ms cubic-bezier(0.2, 0.8, 0.2, 1);
  --motion-quick: 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
  --motion-smooth: 460ms cubic-bezier(0.16, 1, 0.3, 1);
  --motion-reveal: 680ms cubic-bezier(0.22, 1, 0.36, 1);
  --motion-emphasis: 820ms cubic-bezier(0.16, 1, 0.3, 1);
}

/* ---------- Navegação e home formam uma superfície; a marca fica separada ---------- */

.header,
.container__content {
  background: var(--shell-surface) !important;
  border-color: transparent !important;
}

.header {
  box-shadow: none !important;
}

.title-bar {
  background:
    radial-gradient(circle at 50% -140%, rgba(103, 193, 245, 0.13), transparent 48%),
    var(--gradient-header) !important;
  border-color: var(--border-subtle) !important;
  border-bottom: 1px solid var(--border-subtle) !important;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.025),
    0 8px 28px rgba(0, 0, 0, 0.32) !important;
}

.header {
  border: 0 !important;
}

.container__content {
  box-shadow: inset 1px 0 0 rgba(103, 193, 245, 0.035);
}

.home__content {
  background: transparent !important;
}

/* A luz corre pelo shell inteiro sem recriar uma faixa separada. */
.title-bar::selection,
.header::selection {
  background: rgba(103, 193, 245, 0.34);
}

/* A busca continua visível, mas pertence ao mesmo material do shell. */
.header__search {
  background: rgba(35, 50, 65, 0.72) !important;
  border-color: rgba(103, 193, 245, 0.16);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.035),
    0 8px 18px rgba(0, 0, 0, 0.14);
  backdrop-filter: none;
  transition:
    background-color var(--motion-quick),
    border-color var(--motion-quick),
    box-shadow var(--motion-smooth),
    transform var(--motion-smooth);
}

.header__search:hover {
  background: rgba(42, 71, 94, 0.72) !important;
  border-color: rgba(103, 193, 245, 0.28);
  transform: translate3d(0, -1px, 0);
}

.header__search:focus,
.header__search:focus-within {
  background: rgba(42, 71, 94, 0.86) !important;
  border-color: rgba(103, 193, 245, 0.52);
  box-shadow: 0 0 0 3px rgba(26, 159, 255, 0.12), 0 10px 24px rgba(0, 0, 0, 0.2);
  transform: translate3d(0, -1px, 0) scale(1.01);
}

/* ---------- Curvas e entradas: fluidas, curtas e sem blur animado ---------- */

@keyframes steamshit-shell-reveal {
  from {
    opacity: 0;
    transform: translate3d(0, -8px, 0);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

@keyframes steamshit-page-reveal {
  from {
    opacity: 0;
    transform: translate3d(0, 14px, 0) scale(0.994);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }
}

@keyframes steamshit-hero-reveal {
  from {
    opacity: 0;
    transform: translate3d(0, 18px, 0) scale(0.986);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }
}

@keyframes steamshit-popover-reveal {
  from {
    opacity: 0;
    transform: translate3d(0, -7px, 0) scale(0.975);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }
}

@keyframes steamshit-card-reveal {
  from {
    opacity: 0;
    transform: translate3d(0, 20px, 0) scale(0.975);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }
}

@keyframes steamshit-nav-reveal {
  from {
    opacity: 0;
    transform: translate3d(-10px, 0, 0);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

@keyframes steamshit-interaction-sheen {
  from {
    transform: translate3d(-125%, 0, 0) skewX(-14deg);
  }
  to {
    transform: translate3d(125%, 0, 0) skewX(-14deg);
  }
}

@keyframes titlebarFloat {
  0%, 100% { transform: translate3d(0, -50%, 0); }
  50% { transform: translate3d(0, calc(-50% - 1px), 0); }
}

@keyframes titlebarShimmer {
  0%, 12% { background-position: 0% 50%; }
  88%, 100% { background-position: 100% 50%; }
}

.title-bar {
  animation: steamshit-shell-reveal 520ms var(--motion-smooth) backwards;
}

.header {
  animation: steamshit-shell-reveal 560ms 45ms var(--motion-smooth) backwards;
}

.home__content,
.catalogue,
.library__content,
.downloads__container,
.settings__container,
.profile__wrapper,
.achievements__container,
.game-details__container {
  animation: steamshit-page-reveal var(--motion-reveal) 70ms backwards;
}

.hero,
.game-details__hero {
  animation: steamshit-hero-reveal var(--motion-emphasis) 100ms backwards;
}

.context-menu,
.context-menu__submenu,
.dropdown-menu__content,
.modal {
  animation: steamshit-popover-reveal var(--motion-smooth) backwards;
  transform-origin: top right;
}

/* Marca viva, mas sem glow/filtro sendo recalculado continuamente. */
.title-bar::before {
  animation: titlebarFloat 8s ease-in-out infinite;
  filter: drop-shadow(0 0 6px rgba(103, 193, 245, 0.22));
}

.title-bar::after {
  animation: titlebarShimmer 7.5s var(--ease) infinite alternate;
}

/* ---------- Cascata curta: a tela se monta, não simplesmente aparece ---------- */

.game-card,
.game-item,
.download-group__item,
.settings-download-sources__item,
.theme-card {
  animation: steamshit-card-reveal 560ms var(--motion-smooth) backwards;
}

.game-card:nth-child(1),
.game-item:nth-child(1),
.download-group__item:nth-child(1),
.theme-card:nth-child(1) { animation-delay: 110ms; }

.game-card:nth-child(2),
.game-item:nth-child(2),
.download-group__item:nth-child(2),
.theme-card:nth-child(2) { animation-delay: 155ms; }

.game-card:nth-child(3),
.game-item:nth-child(3),
.download-group__item:nth-child(3),
.theme-card:nth-child(3) { animation-delay: 200ms; }

.game-card:nth-child(4),
.game-item:nth-child(4),
.download-group__item:nth-child(4),
.theme-card:nth-child(4) { animation-delay: 245ms; }

.game-card:nth-child(5),
.game-item:nth-child(5),
.download-group__item:nth-child(5),
.theme-card:nth-child(5) { animation-delay: 290ms; }

.game-card:nth-child(n + 6),
.game-item:nth-child(n + 6),
.download-group__item:nth-child(n + 6),
.theme-card:nth-child(n + 6) { animation-delay: 335ms; }

.sidebar__menu-item {
  animation: steamshit-nav-reveal 480ms var(--motion-smooth) backwards;
}

.sidebar__menu-item:nth-child(1) { animation-delay: 60ms; }
.sidebar__menu-item:nth-child(2) { animation-delay: 95ms; }
.sidebar__menu-item:nth-child(3) { animation-delay: 130ms; }
.sidebar__menu-item:nth-child(4) { animation-delay: 165ms; }
.sidebar__menu-item:nth-child(5) { animation-delay: 200ms; }
.sidebar__menu-item:nth-child(n + 6) { animation-delay: 235ms; }

/* ---------- Hero: movimento cinematográfico apenas na interação ---------- */

.hero {
  position: relative;
  isolation: isolate;
}

.hero::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 4;
  pointer-events: none;
  opacity: 0;
  background: linear-gradient(112deg, transparent 28%, rgba(103, 193, 245, 0.08) 48%, transparent 68%);
  transform: translate3d(-125%, 0, 0) skewX(-14deg);
}

.hero:hover::after {
  opacity: 1;
  animation: steamshit-interaction-sheen 920ms var(--motion-smooth) both;
}

.hero img,
.game-details__hero img {
  transition: transform 1100ms var(--motion-smooth);
}

.hero:hover img,
.game-details__hero:hover img {
  transform: scale(1.018);
}

.hero-panel {
  transition:
    background-color var(--motion-quick),
    border-color var(--motion-quick),
    transform var(--motion-smooth);
}

.hero:hover .hero-panel {
  background: rgba(23, 29, 37, 0.84) !important;
  border-color: rgba(103, 193, 245, 0.2) !important;
}

/* ---------- Cards: elevação Prime-like, acento vivo e sem tranco ---------- */

.game-card,
.game-item,
.library-game-card-large,
.library-game-card__wrapper,
.download-group__item,
.user-library-game__wrapper,
.theme-card {
  transition:
    background-color var(--motion-quick),
    border-color var(--motion-quick),
    box-shadow var(--motion-smooth),
    transform var(--motion-smooth);
}

.game-card::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 3;
  pointer-events: none;
  opacity: 0;
  border-radius: inherit;
  background: linear-gradient(115deg, transparent 24%, rgba(255, 255, 255, 0.09) 48%, transparent 72%);
  transform: translate3d(-80%, 0, 0);
  transition: opacity var(--motion-quick), transform 720ms var(--motion-smooth);
}

.game-card:hover::after {
  opacity: 0.8;
  transform: translate3d(80%, 0, 0);
}

.game-card:hover {
  transform: translate3d(0, -6px, 0) scale(1.018);
  box-shadow: 0 18px 44px rgba(0, 0, 0, 0.46), 0 0 0 1px rgba(26, 159, 255, 0.12);
}

.game-card:active {
  transform: translate3d(0, -2px, 0) scale(0.992);
  transition-duration: 110ms;
}

.game-card img {
  filter: none;
  transition: transform 720ms var(--motion-smooth);
}

.game-card:hover img {
  filter: none;
  transform: scale(1.055);
}

.game-card .game-info,
.game-card__content {
  transition: opacity var(--motion-quick), transform var(--motion-smooth);
}

.game-card:hover .game-info,
.game-card:hover .game-card__content {
  transform: translate3d(0, -4px, 0);
}

.game-item:hover,
.download-group__item:hover,
.theme-card:hover,
.library-game-card-large:hover,
.library-game-card__wrapper:hover,
.user-library-game__wrapper:hover {
  transform: translate3d(0, -4px, 0) scale(1.008);
}

.game-item:active,
.download-group__item:active,
.theme-card:active {
  transform: translate3d(0, -1px, 0) scale(0.992);
  transition-duration: 110ms;
}

/* ---------- Botões: deslocamento curto, compressão tátil e brilho guiado ---------- */

.button {
  position: relative;
  overflow: hidden;
  transition:
    background-position var(--motion-smooth),
    background-color var(--motion-quick),
    border-color var(--motion-quick),
    color var(--motion-snap),
    box-shadow var(--motion-smooth),
    transform var(--motion-smooth);
}

.button::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0;
  border-radius: inherit;
  background: linear-gradient(108deg, transparent 26%, rgba(255, 255, 255, 0.16) 49%, transparent 72%);
  transform: translate3d(-115%, 0, 0) skewX(-12deg);
  transition: opacity var(--motion-snap), transform 620ms var(--motion-smooth);
}

.button:hover::after {
  opacity: 1;
  transform: translate3d(115%, 0, 0) skewX(-12deg);
}

.button:hover {
  transform: translate3d(0, -2px, 0) scale(1.015);
}

.button:active {
  transform: translate3d(0, 0, 0) scale(0.972);
  transition-duration: 90ms;
}

.button svg {
  transition: transform var(--motion-smooth);
}

.button:hover svg {
  transform: translate3d(1px, 0, 0) scale(1.045);
}

.button--icon:hover {
  transform: translate3d(0, -2px, 0) scale(1.045);
}

/* ---------- Sidebar e listas: movimento direcional sem animação eterna ---------- */

.sidebar__menu-item--active {
  animation: steamshit-nav-reveal 480ms var(--motion-smooth) backwards;
}

.sidebar__menu-item,
.sidebar-section__button,
.sidebar-profile__button,
.sidebar-profile__friends-button,
.friends-box__list-item,
.recent-games__list-item,
.achievements__item,
.list__item,
.game-details__review-item {
  transition:
    color var(--motion-snap),
    background-color var(--motion-quick),
    border-color var(--motion-quick),
    box-shadow var(--motion-smooth),
    transform var(--motion-smooth);
}

.sidebar__menu-item:hover {
  transform: translate3d(4px, 0, 0);
}

.sidebar__menu-item:hover i,
.sidebar__menu-item:hover svg {
  transform: translate3d(2px, 0, 0) scale(1.04);
}

.friends-box__list-item:hover,
.recent-games__list-item:hover,
.achievements__item:hover,
.list__item:hover,
.game-details__review-item:hover {
  transform: translate3d(4px, 0, 0);
}

/* Remove repaints contínuos onde uma resposta estática é mais elegante. */
.profile-avatar::before,
.achievement-notification--rare .achievement-notification__icon,
.achievement-notification--platinum .achievement-notification__icon {
  animation: none !important;
}

.profile-avatar::before {
  opacity: 0.82;
  transition: opacity var(--motion-quick), transform var(--motion-smooth);
}

.profile-avatar:hover::before {
  opacity: 1;
  transform: scale(1.045);
}

.text-field-container__text-field--dark,
.text-field-container__text-field--primary,
.catalogue__filters-container,
.game-item {
  backdrop-filter: none;
}

/* O contador central continua preso ao eixo, inclusive com os novos hovers. */
.bottom-panel .bottom-panel__downloads-button:hover {
  transform: translate3d(-50%, -1px, 0) scale(1.01);
}

.bottom-panel .bottom-panel__downloads-button:active {
  transform: translate3d(-50%, 0, 0) scale(0.98);
}

@media (hover: none) {
  .header__search:hover,
  .button:hover,
  .button--icon:hover,
  .hero:hover img,
  .game-details__hero:hover img,
  .game-card:hover,
  .game-card:hover img,
  .game-item:hover,
  .download-group__item:hover,
  .theme-card:hover,
  .library-game-card-large:hover,
  .library-game-card__wrapper:hover,
  .user-library-game__wrapper:hover,
  .sidebar__menu-item:hover,
  .sidebar__menu-item:hover i,
  .sidebar__menu-item:hover svg,
  .friends-box__list-item:hover,
  .recent-games__list-item:hover,
  .achievements__item:hover,
  .list__item:hover,
  .game-details__review-item:hover,
  .profile-avatar:hover::before {
    transform: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .title-bar,
  .header,
  .home__content,
  .catalogue,
  .library__content,
  .downloads__container,
  .settings__container,
  .profile__wrapper,
  .achievements__container,
  .game-details__container,
  .hero,
  .game-details__hero,
  .game-card,
  .game-item,
  .download-group__item,
  .settings-download-sources__item,
  .theme-card,
  .sidebar__menu-item,
  .context-menu,
  .context-menu__submenu,
  .dropdown-menu__content,
  .modal,
  .title-bar::before,
  .title-bar::after,
  .hero::after {
    animation: none !important;
  }

  .button::after,
  .game-card::after {
    display: none;
  }
}

/* ========================================================================== */
/* STEAMSHIT 3.3 — LED DO AVATAR NAS RESPOSTAS                              */
/*
   O Hydra aplica overflow:hidden somente ao item de resposta. Isso recortava
   o scale/box-shadow do avatar no hover. A liberação fica restrita às replies.
*/

.game-details__reply-item {
  overflow: visible !important;
}

/* ========================================================================== */
/* STEAMSHIT 3.5 — HEADER NO NAVY DA SIDEBAR + HOME QUADRICULADA             */

:root {
  --home-grid-size: 64px;
  --sidebar-top-surface: #1b2838;
}

/* Mesmo material visual encontrado no topo da sidebar. */
.header {
  background:
    radial-gradient(circle at 0% 0%, rgba(26, 159, 255, 0.1), transparent 28%),
    linear-gradient(180deg, rgba(103, 193, 245, 0.035), transparent 34%),
    var(--sidebar-top-surface) !important;
  border: 0 !important;
  box-shadow: none !important;
}

/* Recupera a trama da home sem criar caixas ou alterar o layout. */
.home__content {
  background-color: transparent !important;
  background-image:
    linear-gradient(rgba(103, 193, 245, 0.07) 1px, transparent 1px),
    linear-gradient(90deg, rgba(103, 193, 245, 0.055) 1px, transparent 1px),
    radial-gradient(circle at 1px 1px, rgba(103, 193, 245, 0.12) 1px, transparent 1.5px),
    radial-gradient(circle at 78% 8%, rgba(26, 159, 255, 0.055), transparent 27%) !important;
  background-size:
    var(--home-grid-size) var(--home-grid-size),
    var(--home-grid-size) var(--home-grid-size),
    var(--home-grid-size) var(--home-grid-size),
    100% 100%;
  background-position: 0 0, 0 0, 0 0, 0 0;
}

/* ========================================================================== */
/* STEAMSHIT 5.2 — STEAM COMMAND DECK: TROPHY ROOM                          */
/*
   Direção autoral construída sobre o Hydra sem reordenar seus controles:
   - o canvas ganha horizonte e um deck em perspectiva, criando "chão";
   - sidebar, header e conteúdo são unidos por trilhos luminosos discretos;
   - docks, recortes assimétricos e marcas de canto criam uma silhueta própria;
   - azul indica navegação/energia; verde fica reservado a jogar/sucesso;
   - toda decoração é não-interativa e fica abaixo dos controles reais.
*/

:root {
  color-scheme: dark;

  /* Canvas e elevação: três níveis claros, sem cinzas desconectados. */
  --market-canvas-deep: #0b1118;
  --market-canvas: #101820;
  --market-navigation: #172433;
  --market-surface: #1c2a38;
  --market-surface-raised: #223446;
  --market-surface-hover: #29445a;
  --market-line: rgba(103, 193, 245, 0.13);
  --market-line-strong: rgba(103, 193, 245, 0.32);

  /* Texto e ações: contraste forte, acento usado com parcimônia. */
  --market-text: #f3f6f8;
  --market-text-secondary: #c7d5e0;
  --market-text-muted: #9aa7b4;
  --market-accent: #67c1f5;
  --market-accent-strong: #1a9fff;
  --market-accent-ink: #07131d;
  --market-success: #8ed629;
  --market-success-deep: #5c9518;
  --achievement-unlocked: #67c1f5;
  --achievement-complete: #8ed629;
  --achievement-rare: #d7a84b;
  --achievement-locked: #687684;

  /* Assinatura Command Deck. */
  --deck-rail: rgba(103, 193, 245, 0.72);
  --deck-rail-soft: rgba(103, 193, 245, 0.18);
  --deck-horizon: 48%;
  --deck-cut: 18px;
  --deck-panel: linear-gradient(145deg, rgba(29, 46, 61, 0.94), rgba(13, 23, 32, 0.96));

  /* Fluent: 83/167/250 ms; reveals maiores continuam deliberadamente suaves. */
  --market-ease-standard: cubic-bezier(0.2, 0.8, 0.2, 1);
  --market-ease-enter: cubic-bezier(0, 0, 0, 1);
  --motion-instant: 83ms cubic-bezier(0.2, 0.8, 0.2, 1);
  --motion-fast: 167ms cubic-bezier(0.2, 0.8, 0.2, 1);
  --motion-normal: 250ms cubic-bezier(0.2, 0.8, 0.2, 1);
  --motion-reveal: 480ms var(--market-ease-enter);
  --motion-cinematic: 720ms cubic-bezier(0.16, 1, 0.3, 1);

  --market-shadow-low: 0 8px 20px rgba(0, 0, 0, 0.2);
  --market-shadow-mid: 0 14px 34px rgba(0, 0, 0, 0.3);
  --market-shadow-high: 0 22px 54px rgba(0, 0, 0, 0.46);
}

/* ---------- Shell: profundidade sem transformar o fundo em protagonista ---------- */

body {
  color: var(--market-text-secondary);
  background: var(--market-canvas-deep) !important;
}

body::before {
  background:
    radial-gradient(circle at 83% -12%, rgba(26, 159, 255, 0.13), transparent 31%),
    radial-gradient(circle at 7% 105%, rgba(65, 122, 155, 0.12), transparent 34%),
    linear-gradient(145deg, #111d28 0%, var(--market-canvas) 46%, var(--market-canvas-deep) 100%);
}

.container__content {
  position: relative;
  isolation: isolate;
  color: var(--market-text-secondary);
  background:
    radial-gradient(circle at 84% 0%, rgba(26, 159, 255, 0.065), transparent 28%),
    linear-gradient(155deg, #111c27 0%, var(--market-canvas) 50%, #0d151d 100%) !important;
  box-shadow: inset 1px 0 0 rgba(103, 193, 245, 0.04);
}

/*
   O deck é desenhado no próprio canvas: linhas radiais convergem para o
   horizonte e as travessas horizontais assentam o conteúdo no espaço.
*/
.container__content::before {
  content: "";
  position: absolute;
  inset: var(--deck-horizon) 0 0;
  z-index: 0;
  pointer-events: none;
  opacity: 0.42;
  background:
    repeating-linear-gradient(
      to bottom,
      transparent 0 42px,
      rgba(103, 193, 245, 0.075) 43px,
      transparent 44px
    ),
    repeating-conic-gradient(
      from 42deg at 50% 0%,
      transparent 0deg 7.1deg,
      rgba(103, 193, 245, 0.075) 7.35deg 7.6deg,
      transparent 7.85deg 14.5deg
    ),
    linear-gradient(to bottom, rgba(26, 159, 255, 0.025), rgba(11, 17, 24, 0.3));
  -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.7) 28%, #000 100%);
  mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.7) 28%, #000 100%);
  transform: translate3d(0, 18px, 0);
  transform-origin: center top;
}

/* O cenário fica atrás; páginas, busca e controles continuam na pilha original. */
.container__content > .header {
  position: relative;
  z-index: 4;
}

.container__content > .home__content,
.container__content > .catalogue,
.container__content > .library__content,
.container__content > .downloads__container,
.container__content > .settings__container,
.container__content > .profile__wrapper,
.container__content > .achievements__container,
.container__content > .game-details__container {
  position: relative;
  z-index: 1;
}

/* Microgrid: perceptível nas áreas vazias e quase invisível atrás das capas. */
.home__content,
.catalogue,
.library__content,
.downloads__container,
.settings__container,
.profile__wrapper,
.achievements__container,
.game-details__container {
  background-color: transparent !important;
  background-image:
    linear-gradient(rgba(103, 193, 245, 0.036) 1px, transparent 1px),
    linear-gradient(90deg, rgba(103, 193, 245, 0.03) 1px, transparent 1px),
    radial-gradient(circle at 1px 1px, rgba(103, 193, 245, 0.075) 1px, transparent 1.4px),
    radial-gradient(circle at 74% 6%, rgba(26, 159, 255, 0.052), transparent 26%) !important;
  background-size: 72px 72px, 72px 72px, 72px 72px, 100% 100%;
  background-position: 0 0, 0 0, 0 0, 0 0;
}

/* Dock de comandos: agrupa filtros sem alterar a área ocupada pelos botões. */
.home__header {
  position: relative;
  isolation: isolate;
}

.home__header::before {
  content: "";
  position: absolute;
  inset: -8px -10px;
  z-index: 0;
  pointer-events: none;
  background:
    linear-gradient(110deg, rgba(103, 193, 245, 0.055), transparent 28%),
    linear-gradient(145deg, rgba(28, 46, 61, 0.72), rgba(11, 20, 29, 0.64));
  border: 1px solid rgba(103, 193, 245, 0.11);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.025), 0 12px 30px rgba(0, 0, 0, 0.18);
  clip-path: polygon(0 0, calc(100% - var(--deck-cut)) 0, 100% var(--deck-cut), 100% 100%, var(--deck-cut) 100%, 0 calc(100% - var(--deck-cut)));
}

.home__header::after {
  content: "";
  position: absolute;
  right: 12%;
  bottom: -9px;
  left: 12%;
  height: 1px;
  z-index: 0;
  pointer-events: none;
  background: linear-gradient(90deg, transparent, rgba(103, 193, 245, 0.32), transparent);
}

.home__header > * {
  position: relative;
  z-index: 1;
}

/* Trilhos sob os títulos organizam visualmente cada setor do deck. */
.home__content h2,
.home__content h3 {
  position: relative;
  text-shadow: 0 2px 16px rgba(0, 0, 0, 0.55);
}

.home__content h2::after,
.home__content h3::after {
  content: "";
  position: absolute;
  bottom: -8px;
  left: 0;
  width: clamp(96px, 18vw, 280px);
  height: 1px;
  pointer-events: none;
  background: linear-gradient(90deg, var(--deck-rail), rgba(103, 193, 245, 0.13) 48%, transparent);
  box-shadow: -4px 0 9px rgba(26, 159, 255, 0.2);
}

/* A marca continua no tom escuro original; navegação superior e sidebar se casam. */
.title-bar {
  background:
    radial-gradient(circle at 50% -170%, rgba(103, 193, 245, 0.1), transparent 48%),
    linear-gradient(90deg, #111a24 0%, #0e151d 48%, #0b1219 100%) !important;
  border-bottom-color: rgba(103, 193, 245, 0.11) !important;
  box-shadow: 0 7px 24px rgba(0, 0, 0, 0.3) !important;
}

.header {
  position: relative;
  isolation: isolate;
  background:
    radial-gradient(circle at 0% 0%, rgba(26, 159, 255, 0.075), transparent 30%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.018), transparent 52%),
    var(--market-navigation) !important;
  border: 0 !important;
  box-shadow: inset 0 -1px 0 rgba(103, 193, 245, 0.045) !important;
}

.header::before {
  content: "";
  position: absolute;
  right: 18px;
  bottom: 0;
  left: 18px;
  height: 1px;
  z-index: 0;
  pointer-events: none;
  opacity: 0.7;
  background: linear-gradient(90deg, var(--deck-rail), rgba(103, 193, 245, 0.14) 30%, transparent 78%);
}

.header::after {
  content: "";
  position: absolute;
  bottom: -2px;
  left: 18px;
  width: 118px;
  height: 4px;
  z-index: 2;
  pointer-events: none;
  opacity: 0.8;
  background: linear-gradient(90deg, var(--market-accent-strong), var(--market-accent), transparent);
  clip-path: polygon(0 0, 100% 0, calc(100% - 12px) 100%, 0 100%);
  box-shadow: 0 0 14px rgba(26, 159, 255, 0.24);
  transform-origin: left center;
}

.header > * {
  position: relative;
  z-index: 1;
}

.sidebar {
  background:
    radial-gradient(circle at 24% 0%, rgba(26, 159, 255, 0.095), transparent 28%),
    linear-gradient(180deg, var(--market-navigation) 0%, #131e29 48%, #0d151d 100%) !important;
  border-right-color: rgba(103, 193, 245, 0.11) !important;
  box-shadow: 14px 0 36px rgba(0, 0, 0, 0.24) !important;
}

.sidebar::before {
  content: "";
  position: absolute;
  top: 0;
  right: -1px;
  bottom: 0;
  width: 2px;
  z-index: 4;
  pointer-events: none;
  opacity: 0.72;
  background: linear-gradient(to bottom, var(--market-accent) 0%, rgba(103, 193, 245, 0.22) 24%, rgba(103, 193, 245, 0.05) 68%, transparent 100%);
  box-shadow: 0 0 14px rgba(26, 159, 255, 0.16);
}

.sidebar::after {
  background: linear-gradient(180deg, rgba(103, 193, 245, 0.035), transparent 100%);
}

.bottom-panel {
  color: var(--market-text-muted);
  background: rgba(11, 17, 24, 0.97) !important;
  border-top-color: rgba(103, 193, 245, 0.11) !important;
  box-shadow: 0 -8px 28px rgba(0, 0, 0, 0.25);
}

.bottom-panel__version-button::after {
  color: var(--market-text-muted);
}

/* ---------- Tipografia: capas chamam atenção; a interface orienta ---------- */

h1,
h2,
h3,
h5,
h6,
.home__header,
.description-header,
.game-card .game-info,
.achievement-notification__title {
  color: var(--market-text);
}

p,
label,
.game-description,
.achievement-notification__description {
  color: var(--market-text-secondary);
}

a,
[role="link"] {
  color: var(--market-accent);
  text-decoration-color: rgba(103, 193, 245, 0.38);
  text-underline-offset: 3px;
}

a:hover,
[role="link"]:hover {
  color: #a9ddfa;
  text-decoration-color: currentColor;
}

/* ---------- Busca e campos: discretos em repouso, inequívocos no foco ---------- */

.header__search,
.text-field-container__text-field--dark,
.text-field-container__text-field--primary {
  color: var(--market-text);
  background: rgba(11, 20, 29, 0.56) !important;
  border-color: rgba(103, 193, 245, 0.15) !important;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.025);
  backdrop-filter: none;
  transition:
    background-color var(--motion-fast),
    border-color var(--motion-fast),
    box-shadow var(--motion-normal),
    transform var(--motion-normal);
}

.header__search:hover,
.text-field-container__text-field--dark:hover,
.text-field-container__text-field--primary:hover {
  background: rgba(28, 48, 65, 0.82) !important;
  border-color: rgba(103, 193, 245, 0.28) !important;
  transform: translate3d(0, -1px, 0);
}

.header__search:focus,
.header__search:focus-within,
.text-field-container__text-field--dark:focus,
.text-field-container__text-field--dark:focus-within,
.text-field-container__text-field--primary:focus,
.text-field-container__text-field--primary:focus-within {
  background: rgba(31, 53, 71, 0.96) !important;
  border-color: var(--market-accent) !important;
  box-shadow: 0 0 0 3px rgba(26, 159, 255, 0.14), var(--market-shadow-low);
  transform: translate3d(0, -1px, 0);
}

input,
select,
textarea,
.select-field__option {
  color: var(--market-text);
  caret-color: var(--market-accent);
}

input::placeholder,
textarea::placeholder,
.select-field__label {
  color: var(--market-text-muted);
  opacity: 0.92;
}

.select-field__option {
  background: var(--market-surface);
  border-color: var(--market-line);
}

/* ---------- Sidebar: uma única trilha de leitura, sem neon permanente ---------- */

.sidebar-section {
  background: rgba(13, 23, 32, 0.58);
  border-color: rgba(103, 193, 245, 0.09);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.018), var(--market-shadow-low);
}

.sidebar__menu-item {
  color: var(--market-text-secondary);
  border-color: transparent;
  background: transparent;
}

.sidebar__menu-item i,
.sidebar__menu-item svg {
  color: var(--market-text-muted);
}

.sidebar__menu-item::after {
  background: linear-gradient(105deg, transparent 18%, rgba(103, 193, 245, 0.08) 48%, transparent 76%);
}

.sidebar__menu-item:hover {
  color: var(--market-text);
  background: linear-gradient(90deg, rgba(41, 68, 90, 0.74), rgba(28, 42, 56, 0.34));
  border-color: rgba(103, 193, 245, 0.1);
  transform: translate3d(3px, 0, 0);
}

.sidebar__menu-item:hover i,
.sidebar__menu-item:hover svg {
  color: var(--market-accent);
}

.sidebar__menu-item--active {
  color: var(--market-text);
  background: linear-gradient(90deg, rgba(47, 91, 119, 0.9), rgba(34, 52, 70, 0.7) 76%, rgba(23, 36, 51, 0.28)) !important;
  border-color: rgba(103, 193, 245, 0.22);
  box-shadow: inset 3px 0 0 var(--market-accent-strong), 0 9px 22px rgba(0, 0, 0, 0.22);
}

.sidebar__menu-item--active::before {
  content: "";
  position: absolute;
  top: 50%;
  right: 11px;
  width: 7px;
  height: 7px;
  z-index: 2;
  pointer-events: none;
  border-top: 2px solid var(--market-accent);
  border-right: 2px solid var(--market-accent);
  filter: drop-shadow(0 0 4px rgba(26, 159, 255, 0.32));
  transform: translate3d(0, -50%, 0) rotate(45deg);
}

.sidebar__menu-item--active i,
.sidebar__menu-item--active svg,
.sidebar__help-button-icon {
  color: var(--market-accent);
}

.sidebar-profile__button,
.sidebar-profile__friends-button {
  color: var(--market-text-secondary);
  background: rgba(13, 23, 32, 0.62);
  border-color: rgba(103, 193, 245, 0.1);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.02);
}

.sidebar-profile__button:hover,
.sidebar-profile__friends-button:hover,
.sidebar-section__button:hover {
  color: var(--market-text);
  background: rgba(41, 68, 90, 0.68);
  border-color: rgba(103, 193, 245, 0.2);
}

/* ---------- Superfícies: o conteúdo sobe pela luz, não por cores aleatórias ---------- */

.settings__content,
.catalogue__filters-container,
.friends-box__box,
.user-stats__box,
.recent-games__box,
.game-item,
.settings-download-sources__item,
.download-group__item,
.theme-card,
.user-karma__box {
  color: var(--market-text-secondary);
  background: linear-gradient(145deg, rgba(30, 47, 62, 0.96), rgba(18, 29, 39, 0.98)) !important;
  border-color: var(--market-line);
  border-radius: 16px 5px 16px 8px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.025), var(--market-shadow-low);
  backdrop-filter: none;
}

.game-details__description-container,
.achievement-panel,
.achievements-content__achievements-list__section__container,
.content-sidebar {
  color: var(--market-text-secondary);
  background: linear-gradient(180deg, rgba(28, 42, 56, 0.96), rgba(13, 22, 30, 0.99)) !important;
  border-color: var(--market-line) !important;
  border-radius: 18px 6px 18px 9px;
}

.description-header,
.hero-panel {
  color: var(--market-text);
  background: rgba(11, 18, 25, 0.78) !important;
  border-color: rgba(103, 193, 245, 0.14) !important;
  border-radius: 16px 5px 16px 8px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.025), var(--market-shadow-mid);
  backdrop-filter: blur(8px);
}

.game-details__review-item,
.how-long-to-beat__category,
.list__item,
.achievements__list {
  color: var(--market-text-secondary);
  background: linear-gradient(135deg, rgba(34, 52, 70, 0.74), rgba(17, 27, 37, 0.92));
  border-color: rgba(103, 193, 245, 0.09);
  border-radius: 14px 4px 14px 7px;
}

.friends-box__list-item:hover,
.recent-games__list-item:hover,
.achievements__item:hover,
.list__item:hover,
.game-details__review-item:hover {
  color: var(--market-text);
  background-color: rgba(41, 68, 90, 0.58);
}

/* ---------- Hero e cards: arte primeiro, informação sempre legível ---------- */

.hero,
.game-details__hero {
  border-color: rgba(103, 193, 245, 0.16);
  box-shadow: var(--market-shadow-mid);
}

.hero {
  position: relative;
  isolation: isolate;
  border-color: rgba(255, 255, 255, 0.08) !important;
  border-radius: var(--steamshit-cut-feature, 18px 6px 18px 9px) !important;
  box-shadow: 0 18px 44px rgba(0, 0, 0, 0.34) !important;
}

/* O anexo mais recente escolhe um hero limpo, sem o recorte azul anterior. */
.hero::before {
  display: none !important;
}

.hero:hover::before {
  display: none !important;
}

.hero::after {
  opacity: 0;
  background: linear-gradient(112deg, transparent 25%, rgba(255, 255, 255, 0.1) 48%, transparent 71%) !important;
  transform: translate3d(-58%, 0, 0) skewX(-14deg);
  animation: none !important;
}

@keyframes steamshit-hero-sheen-instant {
  from { transform: translate3d(-58%, 0, 0) skewX(-14deg); }
  to { transform: translate3d(125%, 0, 0) skewX(-14deg); }
}

.hero:hover::after {
  opacity: 1;
  animation: steamshit-hero-sheen-instant 520ms cubic-bezier(0.16, 1, 0.3, 1) both !important;
}

.hero:hover .hero-panel {
  background: rgba(11, 18, 25, 0.84) !important;
  border-color: rgba(255, 255, 255, 0.12) !important;
}

.game-card {
  border: 1px solid transparent !important;
  border-radius: 0 !important;
  background:
    linear-gradient(var(--market-surface), var(--market-surface)) padding-box,
    linear-gradient(135deg, rgba(103, 193, 245, 0.18), rgba(103, 193, 245, 0.055)) border-box !important;
  background-clip: padding-box, border-box;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.025), var(--market-shadow-low);
}

/* Assinatura dos cards: um pequeno barramento que se completa no hover. */
.game-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 86px;
  height: 3px;
  z-index: 4;
  pointer-events: none;
  opacity: 0.68;
  background: linear-gradient(90deg, var(--market-accent-strong), var(--market-accent), transparent);
  box-shadow: 0 0 10px rgba(26, 159, 255, 0.18);
  transform: scaleX(0.52);
  transform-origin: left center;
  transition: opacity var(--motion-fast), transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
}

.game-card:hover::before {
  opacity: 1;
  transform: scaleX(1);
}

.game-card__backdrop {
  background: linear-gradient(0deg, rgba(7, 13, 19, 0.98) 3%, rgba(12, 20, 28, 0.88) 48%, rgba(12, 20, 28, 0.08) 100%);
}

.game-card .game-info,
.game-card__content {
  color: var(--market-text);
  opacity: 1;
  text-shadow: 0 2px 12px rgba(0, 0, 0, 0.82);
}

.game-card .game-tags span {
  color: var(--market-text-secondary);
  background: rgba(11, 18, 25, 0.82);
  border-color: rgba(103, 193, 245, 0.12);
  backdrop-filter: blur(4px);
}

.game-card::after {
  background: linear-gradient(115deg, transparent 27%, rgba(255, 255, 255, 0.07) 49%, transparent 71%);
}

.game-card:hover {
  border-color: transparent !important;
  background:
    linear-gradient(var(--market-surface-raised), var(--market-surface-raised)) padding-box,
    linear-gradient(115deg, var(--market-accent-strong), var(--market-accent) 46%, rgba(103, 193, 245, 0.3) 72%, var(--market-accent-strong)) border-box !important;
  background-clip: padding-box, border-box;
  box-shadow:
    inset 0 0 0 1px rgba(103, 193, 245, 0.2),
    var(--market-shadow-high),
    0 0 18px rgba(26, 159, 255, 0.13);
  transform: translate3d(0, -5px, 0) scale(1.012);
}

.game-card:hover img {
  filter: saturate(1.04) contrast(1.025);
  transform: scale(1.045);
}

.game-card:hover .game-info,
.game-card:hover .game-card__content {
  transform: translate3d(0, -2px, 0);
}

.game-card:hover .game-tags span {
  color: var(--market-text);
  background: rgba(34, 52, 70, 0.92);
  border-color: rgba(103, 193, 245, 0.28);
}

.game-item:hover,
.settings-download-sources__item:hover,
.download-group__item:hover,
.theme-card:hover,
.library-game-card-large:hover,
.library-game-card__wrapper:hover,
.user-library-game__wrapper:hover {
  background: linear-gradient(145deg, rgba(41, 68, 90, 0.94), rgba(25, 39, 52, 0.99)) !important;
  border-color: var(--market-line-strong);
  box-shadow: var(--market-shadow-mid), 0 0 0 1px rgba(26, 159, 255, 0.055);
  transform: translate3d(0, -3px, 0) scale(1.006);
}

/* ---------- Capas: imagem e hover ocupam o border-box inteiro ---------- */

.game-card img,
.game-card__cover {
  inset: 0;
  display: block;
  width: 100%;
  min-width: 100%;
  height: 100%;
  min-height: 100%;
  object-fit: cover;
  object-position: center;
  border-radius: 0 !important;
  transform-origin: center center;
}

.game-card__backdrop,
.game-card::after {
  border-radius: 0 !important;
}

.library-game-card__wrapper,
.library-game-card-large,
.user-library-game__cover {
  overflow: hidden;
  border: 1px solid transparent !important;
  border-radius: 0 !important;
  background:
    linear-gradient(var(--market-surface), var(--market-surface)) padding-box,
    linear-gradient(135deg, rgba(103, 193, 245, 0.16), rgba(103, 193, 245, 0.045)) border-box !important;
  background-clip: padding-box, border-box;
  box-shadow: var(--market-shadow-low);
}

.library-game-card__wrapper:hover,
.user-library-game__cover:hover,
.library-game-card-large:hover {
  border-color: transparent !important;
  background:
    linear-gradient(var(--market-surface-raised), var(--market-surface-raised)) padding-box,
    linear-gradient(115deg, var(--market-accent-strong), var(--market-accent) 50%, rgba(103, 193, 245, 0.3)) border-box !important;
  background-clip: padding-box, border-box;
  box-shadow:
    inset 0 0 0 1px rgba(103, 193, 245, 0.18),
    var(--market-shadow-mid),
    0 0 16px rgba(26, 159, 255, 0.11);
}

.library-game-card__wrapper::before,
.user-library-game__cover::before,
.library-game-card__game-image,
.user-library-game__game-image {
  border-radius: 0 !important;
}

.library-game-card__wrapper::before,
.user-library-game__cover::before {
  pointer-events: none;
}

.library-game-card__game-image,
.user-library-game__game-image {
  display: block;
  width: 100%;
  min-width: 100%;
  height: 100%;
  min-height: 100%;
  object-fit: cover;
}

/* ---------- Botões: filtros em dock recortado; ações com leitura própria ---------- */

.button {
