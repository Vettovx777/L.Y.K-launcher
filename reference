  isolation: isolate;
  background-clip: padding-box !important;
}

.game-item__plus-wrapper::before,
.game-item__plus-wrapper::after,
.game-item-classics__plus-wrapper::before,
.game-item-classics__plus-wrapper::after {
  border-radius: inherit !important;
}

/*
   Fallback para botões nativos que não usam .button: remove apenas o outline
   retangular. Cada componente conserva seu box-shadow e seu glow específicos.
*/
button:focus-visible {
  outline: none !important;
  outline-offset: 0 !important;
}

/* ========================================================================== */
