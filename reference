/* ========================================================================== */
/* STEAMSHIT 7.0 — ABYSSAL RELAY                                              */
/* ========================================================================== */

/*
   Camada autoral final do Command Deck.

   A personalidade nasce de um sistema repetível — trilhos segmentados, luz
   assimétrica, vidro apenas onde há sobreposição e a mesma silhueta em gota —
   sem reordenar o DOM, criar áreas clicáveis ou trocar containers de rolagem.
*/

:root {
  --relay-ice: #b9e8ff;
  --relay-cyan: #67c1f5;
  --relay-blue: #1a9fff;
  --relay-teal: #54d6c6;
  --relay-edge: rgba(137, 211, 250, 0.18);
  --relay-edge-soft: rgba(103, 193, 245, 0.085);
  --relay-key-shadow: 0 9px 20px rgba(0, 0, 0, 0.24);
  --relay-ambient-shadow: 0 22px 52px rgba(0, 0, 0, 0.27);
  --relay-signal:
    linear-gradient(
      90deg,
      var(--relay-blue) 0 58px,
      transparent 58px 65px,
      rgba(103, 193, 245, 0.54) 65px 104px,
      transparent 104px 111px,
      rgba(103, 193, 245, 0.22) 111px 132px,
      transparent 132px
    );
}

::selection {
  color: #06121b;
  background: rgba(103, 193, 245, 0.86);
}

/*
   Neblina estática de sinal: dá profundidade às áreas vazias, enquanto a
   micrograde e o chão em perspectiva continuam sendo as texturas dominantes.
*/
.container__content::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse 36% 26% at 8% 18%, rgba(103, 193, 245, 0.055), transparent 72%),
    radial-gradient(ellipse 32% 28% at 92% 74%, rgba(84, 214, 198, 0.028), transparent 76%),
    linear-gradient(116deg, transparent 0 47.6%, rgba(103, 193, 245, 0.018) 48.5%, transparent 49.4% 100%);
  opacity: 0.9;
  -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.92), #000 72%, rgba(0, 0, 0, 0.4));
  mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.92), #000 72%, rgba(0, 0, 0, 0.4));
}

/* Barra da marca: presença própria, mas construída com os mesmos azuis. */
.title-bar {
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent 52%),
    radial-gradient(ellipse 34% 175% at 50% -92%, rgba(103, 193, 245, 0.19), transparent 70%),
    linear-gradient(90deg, #0f1821 0%, #152532 28%, #1a3040 50%, #142431 72%, #0e171f 100%) !important;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.035),
    inset 0 -1px 0 rgba(103, 193, 245, 0.1),
    0 8px 26px rgba(0, 0, 0, 0.28) !important;
}

/* O trilho inferior passa a ter a cadência visual de uma linha de telemetria. */
.header::before {
  right: 24px;
  left: 0;
  height: 1px;
  opacity: 0.82;
  background:
    var(--relay-signal) left center / 132px 1px no-repeat,
    linear-gradient(90deg, rgba(103, 193, 245, 0.24), rgba(103, 193, 245, 0.07) 38%, transparent 82%);
  filter: drop-shadow(0 0 5px rgba(26, 159, 255, 0.2));
}

/* O glow solicitado continua fisicamente conectado à lateral. */
.header::after {
  left: 0 !important;
  background: var(--relay-signal) left center / 132px 100% no-repeat;
  box-shadow: 0 0 15px rgba(26, 159, 255, 0.26);
}

/* A sidebar incorpora a gota sem alterar largura, ordem ou hit area. */
.sidebar-section {
  border-radius: var(--steamshit-cut-surface) !important;
  border-top-color: rgba(185, 232, 255, 0.12);
  border-left-color: rgba(103, 193, 245, 0.13);
  box-shadow:
    inset 1px 1px 0 rgba(255, 255, 255, 0.025),
    var(--relay-key-shadow);
}

.sidebar__menu-item,
.sidebar-section__button,
.sidebar-profile__button,
.sidebar-profile__friends-button {
  border-radius: var(--steamshit-cut-control) !important;
}

.sidebar__menu-item--active {
  background:
    linear-gradient(105deg, rgba(53, 105, 137, 0.92), rgba(31, 52, 69, 0.76) 70%, rgba(18, 31, 42, 0.22)) !important;
  box-shadow:
    inset 3px 0 0 var(--relay-blue),
    inset 0 1px 0 rgba(185, 232, 255, 0.08),
    0 11px 25px rgba(0, 0, 0, 0.24),
    -7px 0 18px rgba(26, 159, 255, 0.08);
}

/* Títulos da Home carregam o mesmo pulso segmentado do shell. */
.home__content h2::after,
.home__content h3::after {
  width: clamp(132px, 20vw, 310px);
  height: 2px;
  background:
    var(--relay-signal) left center / 132px 1px no-repeat,
    linear-gradient(90deg, transparent 132px, rgba(103, 193, 245, 0.12), transparent);
  box-shadow: -4px 0 11px rgba(26, 159, 255, 0.24);
}

/*
   Superfícies persistentes permanecem opacas. A luz de borda indica volume e
   procedência sem competir com capas, banners ou informações dos jogos.
*/
.settings__content,
.catalogue__filters-container,
.friends-box__box,
.user-stats__box,
.recent-games__box,
.game-item,
.settings-download-sources__item,
.download-group__item,
.theme-card,
.user-karma__box {
  border-top-color: var(--relay-edge) !important;
  border-right-color: rgba(103, 193, 245, 0.1) !important;
  border-bottom-color: rgba(7, 14, 20, 0.68) !important;
  border-left-color: rgba(103, 193, 245, 0.15) !important;
  box-shadow:
    inset 1px 1px 0 rgba(255, 255, 255, 0.026),
    inset -1px -1px 0 rgba(3, 9, 14, 0.22),
    var(--relay-key-shadow),
    var(--relay-ambient-shadow);
}

.game-item:hover,
.settings-download-sources__item:hover,
.download-group__item:hover,
.theme-card:hover {
  border-top-color: rgba(185, 232, 255, 0.32) !important;
  border-left-color: rgba(103, 193, 245, 0.34) !important;
  box-shadow:
    inset 1px 1px 0 rgba(255, 255, 255, 0.045),
    0 14px 28px rgba(0, 0, 0, 0.3),
    0 26px 58px rgba(0, 0, 0, 0.22),
    -8px 0 20px rgba(26, 159, 255, 0.055);
}

/* Cards de capa ganham profundidade em dois estágios, mantendo o hover integral. */
.game-card,
.library-game-card__wrapper,
.library-game-card-large,
.user-library-game__cover {
  box-shadow:
    0 8px 17px rgba(0, 0, 0, 0.28),
    0 23px 48px rgba(0, 0, 0, 0.18);
}

.game-card:hover,
.library-game-card__wrapper:hover,
.library-game-card-large:hover,
.user-library-game__cover:hover {
  box-shadow:
    inset 0 0 0 1px rgba(185, 232, 255, 0.16),
    0 13px 26px rgba(0, 0, 0, 0.36),
    0 30px 62px rgba(0, 0, 0, 0.26),
    0 0 20px rgba(26, 159, 255, 0.11);
}

/* Uma faixa de comando organiza as abas sem deslocá-las. */
.profile-content__tabs {
  position: relative;
  isolation: isolate;
  background:
    linear-gradient(90deg, rgba(19, 35, 47, 0.9), rgba(12, 23, 32, 0.54) 72%, transparent);
  border-top: 1px solid rgba(185, 232, 255, 0.055);
  border-bottom: 1px solid rgba(103, 193, 245, 0.13);
  border-radius: 13px 4px 13px 5px;
  box-shadow: inset 0 -1px 0 rgba(7, 13, 19, 0.34), 0 10px 24px rgba(0, 0, 0, 0.12);
}

.profile-content__tab {
  border-radius: var(--steamshit-cut-control) !important;
}

.profile-content__tab:hover,
.profile-content__tab:focus-visible {
  background:
    linear-gradient(110deg, rgba(103, 193, 245, 0.11), rgba(103, 193, 245, 0.025)) !important;
}

/* O nome recebe uma assinatura curta; o banner continua sendo apenas cenário. */
.profile-hero__display-name-container {
  position: relative;
}

.profile-hero__display-name-container::after {
  content: "";
  position: absolute;
  bottom: -8px;
  left: 0;
  width: clamp(92px, 13vw, 190px);
  height: 2px;
  pointer-events: none;
  background: var(--relay-signal) left center / 132px 1px no-repeat;
  filter: drop-shadow(0 0 5px rgba(26, 159, 255, 0.26));
}

/* Progresso vira telemetria legível, sem mudar cálculo, largura ou altura. */
.achievements-content__user-summary__container__stats__progress-bar,
.library-game-card__achievement-bar,
.user-library-game__achievements-progress {
  background:
    repeating-linear-gradient(118deg, transparent 0 9px, rgba(255, 255, 255, 0.14) 9px 11px),
    linear-gradient(90deg, var(--relay-blue), var(--relay-cyan) 68%, var(--relay-ice)) !important;
  box-shadow: 0 0 11px rgba(26, 159, 255, 0.26), 0 0 3px rgba(185, 232, 255, 0.2);
}

.achievements__progress-bar::-webkit-progress-value,
.achievement-panel__progress-bar::-webkit-progress-value {
  background:
    repeating-linear-gradient(118deg, transparent 0 9px, rgba(255, 255, 255, 0.14) 9px 11px),
    linear-gradient(90deg, var(--relay-blue), var(--relay-cyan) 68%, var(--relay-ice)) !important;
  box-shadow: 0 0 11px rgba(26, 159, 255, 0.24);
}

/*
   Vidro é reservado a superfícies temporárias. A opacidade continua alta para
   que texto e atalhos sejam legíveis sobre qualquer arte de fundo.
*/
.context-menu,
.context-menu__submenu,
.dropdown-menu__content {
  background:
    radial-gradient(circle at 88% 0%, rgba(103, 193, 245, 0.11), transparent 34%),
    linear-gradient(145deg, rgba(34, 52, 70, 0.93), rgba(10, 18, 26, 0.96)) !important;
  border-color: rgba(137, 211, 250, 0.21) !important;
  border-radius: var(--steamshit-cut-surface) !important;
  box-shadow:
    inset 1px 1px 0 rgba(255, 255, 255, 0.045),
    0 13px 28px rgba(0, 0, 0, 0.4),
    0 30px 70px rgba(0, 0, 0, 0.34) !important;
  -webkit-backdrop-filter: blur(18px) saturate(1.24);
  backdrop-filter: blur(18px) saturate(1.24);
}

.context-menu__item,
.dropdown-menu__item {
  border-radius: 9px 3px 9px 4px;
}

.context-menu__item:hover,
.dropdown-menu__item:hover {
  background:
    linear-gradient(100deg, rgba(53, 105, 137, 0.86), rgba(34, 61, 80, 0.52)) !important;
  box-shadow: inset 2px 0 0 var(--relay-cyan);
}

/* Controles recebem uma borda especular comum, sem trocar sua geometria. */
.button:not(.button--primary):not(.button--filled):not(.button--success):not(.game-details__play-button):not(.game-details__launch-button):not(:disabled),
.filter-item,
.game-details__cloud-sync-button,
.game-details__edit-custom-game-button {
  border-top-color: rgba(185, 232, 255, 0.22) !important;
  box-shadow:
    inset 1px 1px 0 rgba(255, 255, 255, 0.07),
    0 8px 18px rgba(0, 0, 0, 0.23);
}

.button:not(.button--primary):not(.button--filled):not(.button--success):not(.game-details__play-button):not(.game-details__launch-button):not(:disabled):hover,
.filter-item:hover,
.game-details__cloud-sync-button:hover,
.game-details__edit-custom-game-button:hover {
  border-top-color: rgba(185, 232, 255, 0.4) !important;
  box-shadow:
    inset 1px 1px 0 rgba(255, 255, 255, 0.1),
    0 11px 24px rgba(0, 0, 0, 0.3),
    0 0 15px rgba(26, 159, 255, 0.065);
}

/* Scrollbar única: só aparência; nenhum overflow ou scroller é criado aqui. */
::-webkit-scrollbar {
  width: 9px;
  height: 9px;
}

::-webkit-scrollbar-track {
  background: rgba(7, 13, 19, 0.36);
}

::-webkit-scrollbar-thumb {
  min-height: 42px;
  background: linear-gradient(180deg, rgba(103, 193, 245, 0.68), rgba(37, 102, 139, 0.82));
  border: 2px solid rgba(7, 13, 19, 0.7);
  border-radius: 9px 3px 9px 4px;
  box-shadow: inset 1px 1px 0 rgba(185, 232, 255, 0.2);
}

::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(180deg, rgba(185, 232, 255, 0.82), rgba(54, 142, 193, 0.94));
}

::-webkit-scrollbar-corner {
  background: var(--market-canvas-deep);
}

@media (max-width: 768px) {
  .container__content::after {
    opacity: 0.58;
  }

  .profile-content__tabs {
    border-radius: 10px 3px 10px 4px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .container__content::after,
  .profile-hero__display-name-container::after {
    transition: none !important;
    animation: none !important;
  }
}

/* ========================================================================== */
/* STEAMSHIT 7.1 — ASSINATURA AUTORAL                                        */
/* ========================================================================== */

/*
   O h4 original da titlebar já existe no Hydra, mas o tema o mantinha oculto.
   Ele vira o suporte semântico da assinatura, evitando criar sobreposição em
   qualquer botão e preservando integralmente a região central da marca.
*/
.title-bar > h4 {
  position: absolute;
  top: 50%;
  left: 24px;
  z-index: 3;
  display: block !important;
  width: min(205px, 20vw);
  margin: 0;
  padding: 0;
  overflow: visible;
  color: transparent;
  font-size: 0;
  line-height: 1;
  white-space: nowrap;
  pointer-events: none;
  user-select: none;
  transform: translateY(-50%);
}

.title-bar > h4 > * {
  display: none !important;
}

.title-bar > h4::after {
  content: "Labirintite";
  display: block;
  width: fit-content;
  color: rgba(255, 255, 255, 0.94);
  font-family: "Segoe Script", "Brush Script MT", cursive;
  font-size: clamp(16px, 1.15vw, 20px);
  font-style: italic;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 0.025em;
  text-shadow:
    0 0 3px rgba(255, 255, 255, 0.68),
    0 0 10px rgba(255, 255, 255, 0.3),
    0 0 22px rgba(255, 255, 255, 0.13);
  animation: steamshit-author-glow 9s ease-in-out infinite;
}

@keyframes steamshit-author-glow {
  0%, 100% {
    opacity: 0.86;
    text-shadow:
      0 0 3px rgba(255, 255, 255, 0.52),
      0 0 9px rgba(255, 255, 255, 0.23),
      0 0 19px rgba(255, 255, 255, 0.09);
  }

  50% {
    opacity: 1;
    text-shadow:
      0 0 4px rgba(255, 255, 255, 0.82),
      0 0 12px rgba(255, 255, 255, 0.36),
      0 0 25px rgba(255, 255, 255, 0.15);
  }
}

@media (max-width: 1180px) {
  .title-bar > h4 {
    left: 18px;
    width: 170px;
  }

  .title-bar > h4::after {
    font-size: 16px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .title-bar > h4::after {
    opacity: 1;
    animation: none !important;
  }
}

/* ========================================================================== */
/* STEAMSHIT 7.2 — GAME CARD BACKDROP BLEED                                  */
/* ========================================================================== */

/*
   O backdrop nativo media 100% da caixa interna, mas o card usa uma borda
   transparente para desenhar seu contorno luminoso. Durante o zoom da capa,
   essa diferença de 1px deixava a arte reaparecer principalmente embaixo.

   A camada agora sangra até o border-box: capa atrás, película escura no meio
   e informação acima. Nada muda no tamanho, no grid ou na área clicável.
*/
.game-card {
  overflow: hidden !important;
  isolation: isolate;
}

.game-card__backdrop {
  position: absolute !important;
  inset: -1px !important;
  z-index: 0;
  width: auto !important;
  min-width: calc(100% + 2px);
  height: auto !important;
  min-height: calc(100% + 2px);
  overflow: hidden;
  isolation: isolate;
  background: #070d13 !important;
  border-radius: 0 !important;
}

.game-card__backdrop::after {
  content: "";
  position: absolute;
  inset: -1px;
  z-index: 1;
  pointer-events: none;
  background:
    linear-gradient(
      to top,
      rgba(5, 10, 15, 0.99) 0%,
      rgba(7, 13, 19, 0.94) 27%,
      rgba(8, 15, 22, 0.66) 56%,
      rgba(8, 15, 22, 0.08) 100%
    );
  opacity: 0.96;
  transition: opacity var(--motion-fast);
}

.game-card:hover .game-card__backdrop::after,
.game-card:focus-visible .game-card__backdrop::after,
.game-card:focus-within .game-card__backdrop::after {
  opacity: 1;
}

.game-card__backdrop > .game-card__cover,
.game-card__backdrop > img {
  position: absolute !important;
  inset: 0 !important;
  z-index: 0 !important;
  width: 100% !important;
  min-width: 100% !important;
  height: 100% !important;
  min-height: 100% !important;
  border-radius: 0 !important;
}

.game-card__content,
.game-card .game-info {
  position: relative;
  z-index: 2;
}

/* ========================================================================== */
/* STEAMSHIT 7.3 — CENTRO ÓPTICO DO SHELL                                    */
/* ========================================================================== */

/*
   O centro matemático sofre influência visual da massa da sidebar e dos
   controles maiores à direita. Este pequeno deslocamento deliberadamente
   assimétrico faz a marca e o status inferior parecerem centrados ao olhar.
*/
:root {
  --shell-optical-shift: clamp(10px, 0.75vw, 16px);
  --title-group-width: 232px;
  --title-group-half: 116px;
  --title-wordmark-width: 180px;
}

/* Move somente as duas peças que formam a marca central. */
.title-bar::before {
  left: calc(50% - var(--title-group-half) + var(--shell-optical-shift));
}

.title-bar::after {
  left: calc(
    50% - var(--title-group-half) + var(--title-logo-size) +
    var(--title-logo-gap) + var(--shell-optical-shift)
  );
}

/* Move somente "Sem downloads em andamento", preservando o restante. */
.bottom-panel__downloads-button {
  left: calc(50vw + var(--shell-optical-shift));
}

/* ========================================================================== */
/* STEAMSHIT 7.4 — WORDMARK LAUNCHER GRADE                                   */
/* ========================================================================== */

/*
   Menos espaço vazio entre as letras concentra a massa visual da marca. O
   brilho branco-gelo conversa com a assinatura, enquanto o azul final ainda
   conecta o wordmark ao restante do Command Deck.
*/
.title-bar::before {
  filter:
    drop-shadow(0 0 4px rgba(255, 255, 255, 0.2))
    drop-shadow(0 0 9px rgba(103, 193, 245, 0.18));
}

.title-bar::after {
  width: var(--title-wordmark-width);
  color: transparent;
  font-family: Montserrat, "Segoe UI", sans-serif;
  font-size: 18px;
  font-weight: 580;
  letter-spacing: 8.5px;
  background:
    linear-gradient(
      90deg,
      #d8f2ff 0%,
      #ffffff 27%,
      #9bdcff 56%,
      var(--relay-cyan) 76%,
      var(--relay-blue) 100%
    );
  background-size: 400% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  filter:
    drop-shadow(0 0 3px rgba(255, 255, 255, 0.16))
    drop-shadow(0 0 7px rgba(103, 193, 245, 0.2));
}

/* ========================================================================== */
/* STEAMSHIT 7.5 — COVER RESPONSE SYSTEM                                     */
/* ========================================================================== */

/*
   Uma resposta única para toda capa de jogo: aproximação curta da arte,
   contraste controlado, reflexo frio e contorno de foco. O efeito fica preso
   ao recorte de cada card e não alcança banners, screenshots, avatares ou
   imagens de conquistas.
*/
:root {
  --cover-response-time: 520ms;
  --cover-response-ease: cubic-bezier(0.16, 1, 0.3, 1);
  --cover-response-filter: saturate(1.09) contrast(1.045) brightness(1.035);
  --cover-response-glow:
    inset 0 0 0 1px rgba(185, 232, 255, 0.18),
    0 14px 30px rgba(0, 0, 0, 0.36),
    0 0 20px rgba(26, 159, 255, 0.12);
}

/* Superfícies que recortam a arte: nenhuma ampliação pode vazar pela borda. */
.game-card__backdrop,
.library-game-card__wrapper,
.library-game-card__classics-cover,
.library-game-card-large,
.user-library-game__cover,
.game-item__cover-wrapper,
.game-item-classics__cover {
  overflow: hidden;
  isolation: isolate;
}

/* Imagens e backgrounds recebem exatamente a mesma cadência visual. */
.game-card__cover,
.library-game-card__game-image,
.library-game-card__classics-backdrop,
.library-game-card__classics-image,
.library-game-card-large__background,
.library-game-card-large__classics-foreground,
.user-library-game__game-image,
.game-item__cover,
.game-item-classics__cover-backdrop,
.game-item-classics__cover-image,
.download-group__cover,
.download-group__game-image,
.download-group__item > img,
.recent-games__game-image,
.recent-games__list-item img:first-of-type,
.sidebar__game-icon {
  transform-origin: center center;
  backface-visibility: hidden;
  transition:
    transform var(--cover-response-time) var(--cover-response-ease),
    filter 360ms ease,
    box-shadow 360ms ease,
    opacity 360ms ease;
}

/* Reflexo: reutiliza as camadas nativas dos cards de biblioteca e perfil. */
.library-game-card__wrapper::before,
.library-game-card-large::before,
.user-library-game__cover::before {
  inset: 0 !important;
  z-index: 1;
  width: 100% !important;
  height: 172% !important;
  pointer-events: none;
  opacity: 0.2;
  background:
    linear-gradient(
      108deg,
      transparent 18%,
      transparent 39%,
      rgba(216, 244, 255, 0.06) 46%,
      rgba(255, 255, 255, 0.2) 50%,
      rgba(103, 193, 245, 0.08) 55%,
      transparent 64%,
      transparent 100%
    ) !important;
  transform: translate3d(-92%, -36%, 0) skewX(-8deg) !important;
  transition:
    transform 720ms var(--cover-response-ease),
    opacity 220ms ease !important;
}

/* Catálogo não possui a camada nativa acima; o reflexo vive só na capa. */
.game-item__cover-wrapper::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  opacity: 0;
  background:
    linear-gradient(
      112deg,
      transparent 24%,
      rgba(216, 244, 255, 0.16) 48%,
      rgba(103, 193, 245, 0.08) 53%,
      transparent 72%
    );
  transform: translate3d(-115%, 0, 0) skewX(-10deg);
  transition:
    transform 680ms var(--cover-response-ease),
    opacity 180ms ease;
}

@media (hover: hover) and (pointer: fine) {
  /* Home: película, informações e bordas continuam cobrindo o card inteiro. */
  .game-card:is(:hover, :focus-visible, :focus-within) .game-card__cover {
    transform: scale(1.055) translate3d(-0.45%, -0.2%, 0);
    filter: var(--cover-response-filter);
  }

  /* Grade da biblioteca e capas do perfil. */
  .library-game-card__wrapper:is(:hover, :focus-visible, :focus-within)
    .library-game-card__game-image,
  .user-library-game__wrapper:is(:hover, :focus-visible, :focus-within)
    .user-library-game__game-image,
  .user-library-game__cover:is(:hover, :focus-visible, :focus-within)
    .user-library-game__game-image {
    transform: scale(1.05) translate3d(0, -0.2%, 0);
    filter: var(--cover-response-filter);
  }

  /* Capas que usam contain crescem menos para não perder sua moldura. */
  .library-game-card__wrapper:is(:hover, :focus-visible, :focus-within)
    .library-game-card__game-image--contain {
    transform: scale(1.025);
    filter: saturate(1.07) contrast(1.035) brightness(1.035);
  }

  /* Clássicos preservam o blur do fundo e fazem a arte frontal respirar. */
  .library-game-card__wrapper:is(:hover, :focus-visible, :focus-within)
    .library-game-card__classics-backdrop {
    transform: scale(1.3);
    filter: blur(16px) saturate(1.18) contrast(1.04);
  }

  .library-game-card__wrapper:is(:hover, :focus-visible, :focus-within)
    .library-game-card__classics-image {
    transform: scale(1.035);
    filter: saturate(1.06) brightness(1.035);
  }

  /* Cartão largo: o background é uma div, não uma tag img. */
  .library-game-card-large:not(.library-game-card-large--classics):is(:hover, :focus-visible, :focus-within)
    .library-game-card-large__background {
    transform: scale(1.045);
    filter: var(--cover-response-filter);
  }

  .library-game-card-large--classics:is(:hover, :focus-visible, :focus-within)
    .library-game-card-large__background {
    transform: scale(1.235);
    filter: blur(18px) saturate(1.18) contrast(1.04);
  }

  .library-game-card-large:is(:hover, :focus-visible, :focus-within)
    .library-game-card-large__classics-foreground {
    transform: translate(-50%, -50%) scale(1.035);
    filter: saturate(1.06) brightness(1.035);
  }

  /* Resultado de catálogo. */
  .game-item:is(:hover, :focus-within) .game-item__cover {
    transform: scale(1.065) translate3d(-0.65%, 0, 0);
    filter: var(--cover-response-filter);
  }

  .game-item-classics:is(:hover, :focus-within)
    .game-item-classics__cover-image {
    transform: scale(1.035) translate3d(0, -0.35%, 0);
    filter: saturate(1.06) contrast(1.025) brightness(1.035);
  }

  .game-item-classics:is(:hover, :focus-within)
    .game-item-classics__cover-backdrop {
    transform: scale(1.28);
    filter:
      blur(9px)
      saturate(1.12)
      contrast(1.02)
      brightness(0.88);
    opacity: 0.7;
  }

  .game-item:is(:hover, :focus-within) .game-item__cover-wrapper::after {
    opacity: 0.82;
    transform: translate3d(115%, 0, 0) skewX(-10deg);
  }

  /* Fila de downloads e jogos recentes: apenas a primeira arte do item. */
  .download-group__item:is(:hover, :focus-within)
    :is(.download-group__cover, .download-group__game-image, img:first-of-type),
  .recent-games__list-item:is(:hover, :focus-within)
    :is(.recent-games__game-image, img:first-of-type) {
    transform: scale(1.055);
    filter: var(--cover-response-filter);
    box-shadow: 0 0 0 1px rgba(185, 232, 255, 0.18);
  }

  /* A mini-capa da sidebar responde junto com a linha, sem sacudir o texto. */
  .sidebar__menu-item:hover .sidebar__game-icon,
  .sidebar__menu-item:focus-within .sidebar__game-icon,
  .sidebar__game-icon:hover {
    transform: scale(1.12) rotate(0.6deg);
    filter: saturate(1.12) contrast(1.05) brightness(1.06);
    box-shadow:
      0 0 0 1px rgba(185, 232, 255, 0.26),
      0 0 12px rgba(26, 159, 255, 0.18);
  }

  /* O reflexo percorre a arte uma vez por interação. */
  .library-game-card__wrapper:is(:hover, :focus-visible, :focus-within)::before,
  .library-game-card-large:is(:hover, :focus-visible, :focus-within)::before,
  .user-library-game__cover:is(:hover, :focus-visible, :focus-within)::before {
    opacity: 0.82;
    transform: translate3d(92%, -20%, 0) skewX(-8deg) !important;
  }

  /* Realce comum, sem alterar raio, clip-path ou área clicável. */
  .game-card:is(:hover, :focus-visible, :focus-within),
  .library-game-card__wrapper:is(:hover, :focus-visible, :focus-within),
  .library-game-card-large:is(:hover, :focus-visible, :focus-within),
  .user-library-game__cover:is(:hover, :focus-visible, :focus-within),
  .game-item:is(:hover, :focus-within) {
