/* Controles principais, inclusive os botões de ícone e os dois do herói. */
.button,
.home__header .button,
.hero-panel-actions__action,
.game-details__description-toggle,
.filter-item,
.badge,
.game-details__cloud-sync-button,
.game-details__edit-custom-game-button {
