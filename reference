.sidebar__search-row .text-field-container__text-field--dark:focus,
.sidebar__search-row .text-field-container__text-field--dark:focus-visible,
.sidebar__search-row .text-field-container__text-field--dark:focus-within,
.sidebar__search-row .text-field-container__text-field-input,
.sidebar__search-row .text-field-container__text-field-input:hover,
.sidebar__search-row .text-field-container__text-field-input:focus,
