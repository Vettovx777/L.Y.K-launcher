}

.achievements__progress-bar::-webkit-progress-value,
.achievement-panel__progress-bar::-webkit-progress-value {
  background: linear-gradient(90deg, var(--market-accent-strong), var(--market-accent));
  box-shadow: 0 0 10px rgba(26, 159, 255, 0.2);
}

.achievement-panel__progress-bar--disabled {
