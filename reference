  filter: grayscale(0.8);
}

.achievements-content__comparison__container {
  color: var(--market-text-secondary);
  background: rgba(7, 13, 19, 0.82);
  border: 1px solid rgba(103, 193, 245, 0.13);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.025);
  backdrop-filter: blur(7px);
}

.content-sidebar {
  box-shadow: inset 1px 0 0 rgba(103, 193, 245, 0.08), -12px 0 30px rgba(0, 0, 0, 0.16);
}

.content-sidebar .achievement-item,
.content-sidebar .trophy-item,
.content-sidebar .achievements__item {
  background: linear-gradient(135deg, rgba(31, 50, 66, 0.9), rgba(14, 24, 33, 0.96));
  border: 1px solid rgba(103, 193, 245, 0.1);
  border-radius: 10px 3px 10px 5px;
}

/* A correção do LED continua estritamente limitada às respostas. */
.game-details__reply-item {
  overflow: visible !important;
}

/* ---------- Motion: resposta imediata e desaceleração macia ---------- */

@keyframes steamshit-shell-reveal {
  from { opacity: 0; transform: translate3d(0, -6px, 0); }
  to { opacity: 1; transform: translate3d(0, 0, 0); }
}

@keyframes steamshit-page-reveal {
  from { opacity: 0; transform: translate3d(0, 10px, 0); }
  to { opacity: 1; transform: translate3d(0, 0, 0); }
}

@keyframes steamshit-hero-reveal {
  from { opacity: 0; transform: translate3d(0, 14px, 0) scale(0.992); }
  to { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
}

@keyframes steamshit-card-reveal {
  from { opacity: 0; transform: translate3d(0, 12px, 0) scale(0.99); }
  to { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
}

@keyframes steamshit-nav-reveal {
  from { opacity: 0; transform: translate3d(-7px, 0, 0); }
  to { opacity: 1; transform: translate3d(0, 0, 0); }
}

.title-bar {
  animation: steamshit-shell-reveal 420ms var(--market-ease-enter) backwards;
}

.header {
  animation: steamshit-shell-reveal 440ms 30ms var(--market-ease-enter) backwards;
}

.home__content,
.catalogue,
.library__content,
.downloads__container,
.settings__container,
.profile__wrapper,
.achievements__container,
.game-details__container {
  animation: steamshit-page-reveal var(--motion-reveal) 45ms backwards;
}

.hero,
.game-details__hero {
  animation: steamshit-hero-reveal 620ms 70ms cubic-bezier(0, 0, 0, 1) backwards;
}

.game-card,
.game-item,
.download-group__item,
.settings-download-sources__item,
.theme-card {
  animation: steamshit-card-reveal 420ms var(--market-ease-enter) backwards;
}

.game-card:nth-child(1),
.game-item:nth-child(1),
.download-group__item:nth-child(1),
.theme-card:nth-child(1) { animation-delay: 70ms; }

.game-card:nth-child(2),
.game-item:nth-child(2),
.download-group__item:nth-child(2),
.theme-card:nth-child(2) { animation-delay: 100ms; }

.game-card:nth-child(3),
.game-item:nth-child(3),
.download-group__item:nth-child(3),
.theme-card:nth-child(3) { animation-delay: 130ms; }

.game-card:nth-child(4),
.game-item:nth-child(4),
.download-group__item:nth-child(4),
.theme-card:nth-child(4) { animation-delay: 160ms; }

.game-card:nth-child(5),
.game-item:nth-child(5),
.download-group__item:nth-child(5),
.theme-card:nth-child(5) { animation-delay: 190ms; }

.game-card:nth-child(n + 6),
.game-item:nth-child(n + 6),
.download-group__item:nth-child(n + 6),
.theme-card:nth-child(n + 6) { animation-delay: 220ms; }

.sidebar__menu-item {
  animation-duration: 360ms;
  animation-timing-function: cubic-bezier(0, 0, 0, 1);
}

.context-menu,
.context-menu__submenu,
.dropdown-menu__content,
.modal {
  animation-duration: 250ms;
  animation-timing-function: cubic-bezier(0, 0, 0, 1);
}

.title-bar::before {
  animation-duration: 12s;
}

.title-bar::after {
  animation-duration: 9s;
}

.hero img,
.game-details__hero img {
  transition: transform var(--motion-cinematic);
}

.hero:hover img,
.game-details__hero:hover img {
  transform: scale(1.014);
}

.game-card,
.game-item,
.library-game-card-large,
.library-game-card__wrapper,
.download-group__item,
.user-library-game__wrapper,
.theme-card {
  transition:
    background-color var(--motion-fast),
    border-color var(--motion-fast),
    box-shadow var(--motion-normal),
    transform var(--motion-normal);
}

.game-card img {
  transition: transform 520ms cubic-bezier(0.16, 1, 0.3, 1), filter var(--motion-normal);
}

.button::after {
