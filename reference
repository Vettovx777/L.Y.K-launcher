}

/* Botões circulares permanecem círculos; nenhum hover pode virar quadrado. */
.game-item__plus-wrapper,
.game-item__plus-wrapper:hover,
.game-item__plus-wrapper:focus-visible,
.game-item__plus-wrapper:active,
.game-item-classics__plus-wrapper,
.game-item-classics__plus-wrapper:hover,
.game-item-classics__plus-wrapper:focus-visible,
.game-item-classics__plus-wrapper:active {
